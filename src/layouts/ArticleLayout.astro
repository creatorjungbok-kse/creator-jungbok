---
// 글 상세 화면(cost·compare·guide·change·benefit 공통 틀). 블록 순서는 유형별로 고정이고, 내용이 있는 블록만 나온다.
// - benefit: 상태 → 한눈에 보기 → 공식 신청·안내 링크 → 내가 해당되는지 → (본문) → 준비할 것 → 꼭 알아둘 것 → FAQ
// - 그 밖의 글: 결론 → (도구·한눈에 보기·적용 시점·가격표·비교표·guide 준비할 것) → (본문) → 준비할 것 → 꼭 알아둘 것 → 공식 링크 → FAQ
//   단 guide는 공식 링크를 본문 앞(정리 블록 바로 뒤)에 둔다
// 공통 끝부분: 다음에 볼 정보(최대 3개, 없으면 숨김) → 출처·업데이트 기록(한 칸).
// 화면 규칙: 글 안의 모든 블록은 같은 폭(왼쪽·오른쪽 끝 정렬), 구역마다 같은 크기 제목 + 위 구분선.
// 목차는 제목이 있는 모든 구역(블록 + 본문 H2 + FAQ + 출처)을 화면 순서대로 담고, 3개 이상일 때만 보인다.
import BaseLayout from './BaseLayout.astro';
import ActionLinks from '../components/ActionLinks.astro';
import ArticleFeedback from '../components/ArticleFeedback.astro';
import AdSlot from '../components/AdSlot.astro';
import BlogSidebar from '../components/BlogSidebar.astro';
import ContentCard from '../components/ContentCard.astro';
import Thumbnail from '../components/Thumbnail.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Checklist from '../components/Checklist.astro';
import CompareTable from '../components/CompareTable.astro';
import FactList from '../components/FactList.astro';
import PriceTable from '../components/PriceTable.astro';
import SectionTitle from '../components/SectionTitle.astro';
import SourceList from '../components/SourceList.astro';
import StatusBanner from '../components/StatusBanner.astro';
import SummaryBox from '../components/SummaryBox.astro';
import Toc, { type Props as TocProps } from '../components/Toc.astro';
import { toolComponents } from '../components/tools';
import type { AdSlotId } from '../config/ads';
import { audiences } from '../data/audiences';
import { categories, categoryHref, subcategoryName } from '../data/categories';
import { people } from '../data/people';
import type { ContentItem } from '../lib/content';
import { contentAdSlots, splitBody, topCut } from '../lib/ads';
import { statusLabels } from '../lib/benefit-status';
import { statusOf } from '../lib/select';
import { applicationPeriod, formatDate } from '../lib/format';
import { articleJsonLd } from '../lib/seo';
import { citedSources } from '../lib/sources';

export interface Props {
  item: ContentItem;
  // 본문 H2·H3
  headings: TocProps['headings'];
  // lib/related.ts 결과(최대 3개, 순서 유지)
  related: ContentItem[];
}

const { item, headings, related } = Astro.props;
const { data } = item.entry;
const category = categories.find((c) => c.slug === item.category)!;
const nameOf = (id: string) => people.find((p) => p.id === id)!.name;
const isoDate = (d: Date) => d.toISOString().slice(0, 10);

// 본문 H2 수(광고 자리 계산에 쓴다)
const sections = headings.filter((h) => h.depth === 2).length;
const history = [...(data.changelog ?? [])].sort((a, b) => +b.date - +a.date);

// 지원·혜택: 한눈에 보기 4항목 + 보조 정보(스키마에 있는 값만)
const program = item.kind === 'benefit' ? item.entry.data.program : undefined;
const status = item.kind === 'benefit' ? statusOf(item)! : undefined;
const audienceNames = item.kind === 'benefit' ? item.entry.data.audience.map((id) => audiences.find((a) => a.id === id)!.name) : [];
const quickFacts = program && [
  { label: '대상', value: `${audienceNames.join('·')} · ${program.region}` },
  { label: '금액·혜택', value: program.benefit.text },
  { label: '신청기간', value: applicationPeriod(program.application)! },
  { label: '현재 상태', value: statusLabels[status!] },
];
const quickNotes = program && [
  `운영 ${program.operator}`,
  ...(program.round ? [`회차 ${program.round}`] : []),
  ...(program.payoutSchedule ? [`지급 ${program.payoutSchedule}`] : []),
  ...(program.validFrom || program.validTo
    ? [`혜택 기간 ${[program.validFrom, program.validTo].map((d) => (d ? formatDate(d) : '')).join(' ~ ')}`]
    : []),
];

const article = item.kind === 'article' ? item.entry.data : undefined;
const change = article?.change;
const changeFacts = change && [
  { label: '시행일', value: formatDate(change.effectiveFrom) },
  ...(change.effectiveUntil ? [{ label: '종료일', value: formatDate(change.effectiveUntil) }] : []),
];
const priceItems = article?.priceItems;
const isGuide = article?.contentType === 'guide';
const checklist = article?.checklist;
// 사이트 도구(cost 글만): 결론 바로 아래. 도구가 없는 글에는 script가 하나도 붙지 않는다
const Tool = article?.tool ? toolComponents[article.tool] : undefined;

// 목차: 화면에 나오는 순서 그대로(제목이 있는 구역만)
const sec = (id: string, text: string, show: unknown) => (show ? [{ id, text, depth: 2 as const }] : []);
const hasDocs = (program?.application.documents?.length ?? 0) > 0;
const tocAll: TocProps['headings'] = program
  ? [
      ...sec('apply', '공식 신청·안내', true),
      ...sec('eligibility', '내가 해당되는지', true),
      ...headings,
      ...sec('documents', '준비할 것', hasDocs),
      ...sec('notes', '꼭 알아둘 것', data.notes),
      ...sec('faq', '자주 묻는 질문', data.faq?.length),
      ...sec('sources', '출처·업데이트', true),
    ]
  : [
      ...sec('checklist', checklist?.title ?? '준비할 것', isGuide && checklist),
      ...sec('apply', '공식 사이트에서 확인', isGuide && data.actionLinks),
      ...headings,
      ...sec('checklist', checklist?.title ?? '준비할 것', !isGuide && checklist),
      ...sec('notes', '꼭 알아둘 것', data.notes),
      ...sec('apply', '공식 사이트에서 확인', !isGuide && data.actionLinks),
      ...sec('faq', '자주 묻는 질문', data.faq?.length),
      ...sec('sources', '출처·업데이트', true),
    ];
const toc = tocAll.filter((h) => h.depth === 2).length >= 3 ? tocAll : [];

// 광고 슬롯(03 4~6장). 광고가 꺼져 있으면 contentAdSlots가 빈 집합이라 아래 자리는 모두 출력되지 않는다.
// [후속] 분량 판단이 본문 H2 수 기준이라 블록 중심 글에서는 실제 길이와 어긋날 수 있다(docs/05 후속 항목).
const adSlots = contentAdSlots(item, sections);
const isArticle = item.kind === 'article';
const bodyHtml = (await Astro.slots.render('default')).trim();
// 본문 안 자리: article-mid(가운데 H2 앞), article-top(모바일 첫 화면 밖이 되는 첫 H2 앞). 광고가 꺼져 있으면 나누지 않는다
const midAt = Math.max(Math.floor(sections / 2), 3);
const topAt = isArticle && adSlots.has('top') ? topCut(bodyHtml, priceItems?.length ? priceItems.length * 48 + 100 : 0, adSlots.has('mid') ? midAt - 1 : sections) : undefined;
const bodyCuts = isArticle
  ? [...(topAt ? [{ h2: topAt, id: 'article-top' as const }] : []), ...(adSlots.has('mid') ? [{ h2: midAt, id: 'article-mid' as const }] : [])]
  : [];
const bodyParts = bodyHtml ? splitBody(bodyHtml, bodyCuts) : [];
// 본문 바로 뒤 자리(article-lower / benefit-mid): 다음 블록이 광고 금지 영역(공식 링크·관련 글)이면 생략한다
const afterBodyAd: AdSlotId = isArticle ? 'article-lower' : 'benefit-mid';
// benefit은 본문 뒤 준비할 것·꼭 알아둘 것(제외·주의 조건)까지 지난 다음 자리(01 F-2 ⑫ 뒤)
const nextIsSafe = isArticle
  ? !!(checklist && !isGuide) || !!data.notes || ((isGuide || !data.actionLinks) && (!!data.faq?.length || related.length === 0))
  : !!data.faq?.length || related.length === 0;
const showAfterBodyAd = bodyParts.length > 0 && adSlots.has(isArticle ? 'lower' : 'mid') && nextIsSafe;
---

<BaseLayout title={data.seoTitle ?? data.title} description={data.description ?? data.summary} ogType="article" image={data.ogImage} jsonLd={[articleJsonLd(item)]}>
  <div class="container page-grid">
    <article class="article">
      <Breadcrumb items={[{ label: category.name, href: categoryHref(category) }]} />
      <header class:list={['article__head', { 'article__head--thumb': data.thumbnail }]}>
        <div class="article__titles">
          <p class="article__category">
            <a href={categoryHref(category)}>{category.name}</a> · {subcategoryName(category, data.subcategory)}
          </p>
          <h1>{data.title}</h1>
          <p class="article__meta">
            <span>작성 {nameOf(data.author)}</span>
            {data.reviewer && <span>검수 {nameOf(data.reviewer)}</span>}
            <span>최종 업데이트 <time datetime={isoDate(data.dateModified)}>{formatDate(data.dateModified)}</time></span>
            {isArticle && <span>조사 기준일 {formatDate(data.researchedAt)}</span>}
          </p>
        </div>
        {data.thumbnail && <Thumbnail src={data.thumbnail} label={category.name} tone={category.slug} eager />}
      </header>

      {
        program ? (
          <>
            <StatusBanner program={program} />
            <FactList title="한눈에 보기" items={quickFacts!} variant="quick" notes={quickNotes} />
            <Toc headings={toc} variant="inline" />
            <ActionLinks id="apply" title="공식 신청·안내" links={data.actionLinks!} status={status} methods={program.application.methods} />
            <Checklist id="eligibility" title="내가 해당되는지" items={program.eligibility.map((e) => e.text)} protect="eligibility">
              {(program.exclusions?.length ?? 0) > 0 && <p class="article__exclusions">이런 경우는 제외: {program.exclusions!.map((e) => e.text).join(' / ')}</p>}
            </Checklist>
          </>
        ) : (
          <>
            <SummaryBox summary={data.summary} />
            <Toc headings={toc} variant="inline" />
            {Tool && <Tool />}
            {article?.quickFacts && <FactList title={article.quickFacts.title} items={article.quickFacts.items} variant="quick" />}
            {changeFacts && <FactList title="적용 시점" items={changeFacts} />}
            {priceItems && priceItems.length > 0 && <PriceTable caption="항목별 가격 범위" items={priceItems} researchedAt={data.researchedAt} />}
            {article?.compare && <CompareTable caption={article.compare.caption} options={article.compare.options} rows={article.compare.rows} />}
            {isGuide && checklist && <Checklist id="checklist" title={checklist.title ?? '준비할 것'} items={checklist.items} />}
            {isGuide && data.actionLinks && <ActionLinks id="apply" title="공식 사이트에서 확인" links={data.actionLinks} />}
          </>
        )
      }

      {
        bodyParts.map((part) => (
          <>
            {part.adBefore && <AdSlot id={part.adBefore} />}
            <div class="prose" set:html={part.html} />
          </>
        ))
      }
      {isArticle && showAfterBodyAd && <AdSlot id={afterBodyAd} />}

      {
        isArticle ? (
          <>
            {checklist && !isGuide && <Checklist id="checklist" title={checklist.title ?? '준비할 것'} items={checklist.items} />}
            {data.notes && <Checklist id="notes" title="꼭 알아둘 것" items={data.notes} marker="note" />}
            {!isGuide && data.actionLinks && <ActionLinks id="apply" title="공식 사이트에서 확인" links={data.actionLinks} />}
          </>
        ) : (
          <>
            {hasDocs && <Checklist id="documents" title="준비할 것" items={program!.application.documents!} />}
            {data.notes && <Checklist id="notes" title="꼭 알아둘 것" items={data.notes} marker="note" />}
            {showAfterBodyAd && <AdSlot id={afterBodyAd} />}
          </>
        )
      }

      {
        data.faq && data.faq.length > 0 && (
          <section id="faq" class="faq">
            <SectionTitle title="자주 묻는 질문" tier="article" />
            {data.faq.map((f) => (
              <div class="faq__item">
                <h3>{f.question}</h3>
                <p>{f.answer}</p>
              </div>
            ))}
          </section>
        )
      }

      <ArticleFeedback />

      {
        related.length > 0 && (
          <section data-ad-protected="related">
            <SectionTitle title="다음에 볼 정보" tier="article" />
            <div class="card-list">
              {related.map((r) => (
                <ContentCard item={r} variant="row" />
              ))}
            </div>
          </section>
        )
      }

      <footer id="sources" class="article__end">
      <SourceList sources={citedSources(data)} />

      <section class="history">
        <SectionTitle title="업데이트 기록" />
        <ol>
          {
            history.map((c) => (
              <li>
                <time datetime={isoDate(c.date)}>{formatDate(c.date)}</time> {c.summary}
              </li>
            ))
          }
          <li><time datetime={isoDate(data.datePublished)}>{formatDate(data.datePublished)}</time> 최초 작성</li>
        </ol>
      </section>
      </footer>
    </article>

    {
      toc.length > 0 ? (
        <aside class="page-aside article-aside" aria-label="글 보조 정보">
          <Toc headings={toc} variant="sidebar" />
        </aside>
      ) : (
        <aside class="page-aside desktop-only" aria-label="카테고리와 도구">
          <BlogSidebar current={item.category} exclude={item.url} />
        </aside>
      )
    }
  </div>
</BaseLayout>

<style is:global>
  /* ── 글 화면 구역 체계(블록·본문 공통) ─────────────────────────────
     모든 요소가 같은 폭(왼쪽·오른쪽 끝 정렬)이고, 제목이 있는 구역은 같은 크기 제목 + 위 구분선 + 같은 여백.
     컴포넌트의 기본 제목 크기보다 우선하도록 .article 아래에서만 덮어쓴다. */
  .article > section:not(.fact-list--quick, .summary-box, .feedback) {
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .article > section > h2,
  .article .prose h2 {
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    letter-spacing: -0.01em;
    line-height: var(--leading-tight);
  }

  .article .prose {
    max-width: none;
  }

  .article .prose h2 {
    margin-top: var(--space-7);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .article .prose > h2:first-child {
    margin-top: 0;
  }

  /* 본문 표: 칸 안 글자는 줄바꿈(가로 스크롤은 정말 넓을 때만), 머리 칸은 한 줄 */
  .article .prose table {
    white-space: normal;
  }

  /* 한국어는 단어(어절) 단위로만 줄바꿈: 금액·날짜 숫자가 중간에 끊기지 않게 */
  .article .prose :is(td, th) {
    word-break: keep-all;
    overflow-wrap: normal;
  }

  .article .prose th {
    white-space: nowrap;
  }

  /* 본문 화면 캡처: 글 폭에 맞추고 테두리로 본문과 구분, 아래에 설명 한 줄 */
  .article .prose figure.shot {
    margin: var(--space-5) 0;
  }

  .article .prose figure.shot img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .article .prose figure.shot a {
    display: block;
  }

  .article .prose figure.shot figcaption {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  /* 목차로 이동했을 때 고정 헤더에 제목이 가리지 않게 */
  .article [id] {
    scroll-margin-top: calc(var(--header-h) + var(--space-4));
  }

  /* 글 끝: 출처·업데이트 기록을 옅은 칸 하나로 */
  .article > .article__end {
    display: grid;
    gap: var(--space-5);
    padding: var(--space-5);
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .article__end .section-title {
    margin-bottom: var(--space-3);
  }
</style>

<style>
  .article {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: start;
    gap: var(--space-6);
    min-width: 0;
    max-width: 47.5rem;
  }

  /* 글 머리: 분류 · 제목 · 작성 정보. 대표 이미지는 모바일에서 아래, 태블릿 이상에서 오른쪽 작은 칸 */
  .article__head {
    display: grid;
    gap: var(--space-4);
  }

  .article__titles {
    display: grid;
    align-content: center;
    gap: var(--space-2);
  }

  @media (min-width: 768px) {
    .article__head--thumb {
      grid-template-columns: minmax(0, 1fr) 13.5rem;
      align-items: center;
      gap: var(--space-5);
    }
  }

  .article__category {
    color: var(--color-brand-text);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  .article__category a {
    color: inherit;
  }

  .article__head h1 {
    font-size: var(--text-2xl);
    letter-spacing: -0.02em;
  }

  .article__meta {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .article__meta span + span::before {
    content: '·';
    margin-inline: var(--space-2);
  }

  .article__exclusions {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .faq__item {
    padding-block: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .faq__item h3 {
    font-size: var(--text-md);
    font-weight: var(--weight-semibold);
  }

  .faq__item p {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
  }

  .history ol {
    display: grid;
    gap: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .history time {
    margin-right: var(--space-2);
    font-variant-numeric: tabular-nums;
  }
</style>
