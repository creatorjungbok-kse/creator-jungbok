---
// 글 상세 화면(cost·compare·guide·change·benefit 공통 틀). 유형별 차이는 상단 블록에서만 난다.
import BaseLayout from './BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import ArticleCard from '../components/ArticleCard.astro';
import BenefitCard from '../components/BenefitCard.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FactList from '../components/FactList.astro';
import MiniList from '../components/MiniList.astro';
import OfficialCta from '../components/OfficialCta.astro';
import PriceTable from '../components/PriceTable.astro';
import SectionTitle from '../components/SectionTitle.astro';
import SourceList from '../components/SourceList.astro';
import StatusBanner from '../components/StatusBanner.astro';
import SummaryBox from '../components/SummaryBox.astro';
import Toc, { type Props as TocProps } from '../components/Toc.astro';
import type { AdSlotId } from '../config/ads';
import { audiences } from '../data/audiences';
import { categories, categoryHref } from '../data/categories';
import { people } from '../data/people';
import type { ContentItem } from '../lib/content';
import { contentAdSlots, splitBody, topCut } from '../lib/ads';
import { statusOf } from '../lib/select';
import { applicationPeriod, formatDate } from '../lib/format';
import { articleJsonLd } from '../lib/seo';
import { citedSources } from '../lib/sources';

export interface Props {
  item: ContentItem;
  // 본문 H2·H3
  headings: TocProps['headings'];
  // lib/related.ts 결과(순서 유지). 앞 3개는 본문 아래 카드, 다음 5개는 사이드바 목록
  related: ContentItem[];
}

const { item, headings, related } = Astro.props;
const { data } = item.entry;
const category = categories.find((c) => c.slug === item.category)!;
const nameOf = (id: string) => people.find((p) => p.id === id)!.name;
const isoDate = (d: Date) => d.toISOString().slice(0, 10);
const categoryName = (i: ContentItem) => categories.find((c) => c.slug === i.category)!.name;

const toc: TocProps['headings'] = data.faq?.length ? [...headings, { id: 'faq', text: '자주 묻는 질문', depth: 2 }] : headings;
const history = [...(data.changelog ?? [])].sort((a, b) => +b.date - +a.date);

// 상단 사실 목록: 스키마에 있는 값만 표시한다
const program = item.kind === 'benefit' ? item.entry.data.program : undefined;
const programFacts = program && [
  { label: '운영 기관', value: program.operator },
  { label: '지역', value: program.region },
  ...(program.round ? [{ label: '회차', value: program.round }] : []),
  { label: '대상', value: program.eligibility.map((e) => e.text) },
  ...(program.exclusions?.length ? [{ label: '제외 대상', value: program.exclusions.map((e) => e.text) }] : []),
  { label: '지원 내용', value: program.benefit.text },
  { label: '신청 기간', value: applicationPeriod(program.application)! },
  ...(program.application.methods?.length ? [{ label: '신청 방법', value: program.application.methods }] : []),
  ...(program.application.documents?.length ? [{ label: '제출 서류', value: program.application.documents }] : []),
  ...(program.payoutSchedule ? [{ label: '지급 시기', value: program.payoutSchedule }] : []),
  ...(program.validFrom || program.validTo
    ? [{ label: '혜택 기간', value: [program.validFrom, program.validTo].map((d) => (d ? formatDate(d) : '')).join(' ~ ') }]
    : []),
];
const change = item.kind === 'article' ? item.entry.data.change : undefined;
const changeFacts = change && [
  { label: '시행일', value: formatDate(change.effectiveFrom) },
  ...(change.effectiveUntil ? [{ label: '종료일', value: formatDate(change.effectiveUntil) }] : []),
];
const priceItems = item.kind === 'article' ? item.entry.data.priceItems : undefined;
const audienceNames = item.kind === 'benefit' ? item.entry.data.audience.map((id) => audiences.find((a) => a.id === id)!.name) : [];

// 광고 슬롯(03 4~6장). 광고가 꺼져 있으면 contentAdSlots가 빈 집합이라 아래 자리는 모두 출력되지 않는다.
const sections = headings.filter((h) => h.depth === 2).length;
const adSlots = contentAdSlots(item, sections);
const isArticle = item.kind === 'article';
// 본문 안 자리(광고가 꺼져 있으면 본문을 나누지 않는다):
// - article-mid: 가운데 H2 앞(3번째 H2 이후)
// - article-top: 첫 번째 본문 섹션 이후 중 모바일 첫 화면 밖이 되는 첫 H2 앞, mid와는 섹션 2개 이상 간격. 요약·목차와 붙지 않는다
const bodyHtml = isArticle && (adSlots.has('top') || adSlots.has('mid')) ? await Astro.slots.render('default') : undefined;
const midAt = Math.max(Math.floor(sections / 2), 3);
const topAt = bodyHtml && adSlots.has('top') ? topCut(bodyHtml, priceItems?.length ? priceItems.length * 48 + 100 : 0, adSlots.has('mid') ? midAt - 1 : sections) : undefined;
const bodyCuts = [
  ...(topAt ? [{ h2: topAt, id: 'article-top' as const }] : []),
  ...(adSlots.has('mid') ? [{ h2: midAt, id: 'article-mid' as const }] : []),
];
const bodyParts = bodyHtml && bodyCuts.length ? splitBody(bodyHtml, bodyCuts) : undefined;
// 본문 뒤·FAQ 앞(article-lower / benefit-mid: 공식 신청 버튼과 본문 전체만큼 떨어진 자리).
// FAQ 없이 바로 관련 글 카드가 오면 카드 바로 옆이 되므로 생략한다
const afterBodyAd: AdSlotId = isArticle ? 'article-lower' : 'benefit-mid';
const showAfterBodyAd = adSlots.has(isArticle ? 'lower' : 'mid') && (!!data.faq?.length || related.length === 0);
---

<BaseLayout title={data.title} description={data.description ?? data.summary} ogType="article" jsonLd={[articleJsonLd(item)]}>
  <div class="container page-grid">
    <article class="article">
      <Breadcrumb items={[{ label: category.name, href: categoryHref(category) }]} />
      <header class="article__head">
        <p class="article__category">{category.name}{audienceNames.length > 0 && ` · ${audienceNames.join('·')}`}</p>
        <h1>{data.title}</h1>
        <p class="article__meta">
          <span>작성 {nameOf(data.author)}</span>
          {data.reviewer && <span>검수 {nameOf(data.reviewer)}</span>}
          <span>최종 업데이트 <time datetime={isoDate(data.dateModified)}>{formatDate(data.dateModified)}</time></span>
          {item.kind === 'article' && <span>조사 기준일 {formatDate(data.researchedAt)}</span>}
        </p>
      </header>

      {
        program ? (
          <>
            <StatusBanner program={program} />
            <SummaryBox title="핵심 요약" summary={data.summary} />
            <OfficialCta href={program.application.officialUrl} status={statusOf(item)!} />
            <FactList title="지원 정보" items={programFacts!} />
          </>
        ) : (
          <>
            <SummaryBox summary={data.summary} />
            {changeFacts && <FactList title="적용 시점" items={changeFacts} />}
            {priceItems && priceItems.length > 0 && <PriceTable caption="항목별 가격 범위" items={priceItems} researchedAt={data.researchedAt} />}
          </>
        )
      }

      <Toc headings={toc} variant="inline" />
      {
        bodyParts ? (
          bodyParts.map((part) => (
            <>
              {part.adBefore && <AdSlot id={part.adBefore} />}
              <div class="prose" set:html={part.html} />
            </>
          ))
        ) : (
          <div class="prose">
            <slot />
          </div>
        )
      }
      {showAfterBodyAd && <AdSlot id={afterBodyAd} />}

      {
        data.faq && data.faq.length > 0 && (
          <section id="faq" class="faq">
            <SectionTitle title="자주 묻는 질문" />
            {data.faq.map((f) => (
              <div class="faq__item">
                <h3>{f.question}</h3>
                <p>{f.answer}</p>
              </div>
            ))}
          </section>
        )
      }

      {
        related.length > 0 && (
          <section data-ad-protected="related">
            <SectionTitle title="함께 보면 좋은 정보" />
            <div class="card-grid card-grid--3">
              {related.slice(0, 3).map((r) =>
                r.kind === 'benefit' ? (
                  <BenefitCard href={r.url} title={r.entry.data.title} program={r.entry.data.program} audience={r.entry.data.audience} />
                ) : (
                  <ArticleCard href={r.url} title={r.entry.data.title} category={categoryName(r)} meta={[`업데이트 ${formatDate(r.entry.data.dateModified)}`]} />
                ),
              )}
            </div>
          </section>
        )
      }

      <SourceList sources={citedSources(data)} />

      <section class="history">
        <SectionTitle title="업데이트 기록" />
        <ol>
          {
            history.map((c) => (
              <li>
                <time datetime={isoDate(c.date)}>{formatDate(c.date)}</time> {c.summary}
              </li>
            ))
          }
          <li><time datetime={isoDate(data.datePublished)}>{formatDate(data.datePublished)}</time> 최초 작성</li>
        </ol>
      </section>
    </article>

    <aside class="page-aside article-aside" aria-label="글 보조 정보">
      <Toc headings={toc} variant="sidebar" />
      {
        related.length > 3 && (
          <MiniList title="더 볼 만한 글" items={related.slice(3, 8).map((r) => ({ href: r.url, title: r.entry.data.title, meta: categoryName(r) }))} />
        )
      }
    </aside>
  </div>
</BaseLayout>

<style>
  .article {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: start;
    gap: var(--space-5);
    min-width: 0;
  }

  .article__head {
    display: grid;
    gap: var(--space-2);
  }

  .article__category {
    color: var(--color-brand-text);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  .article__head h1 {
    font-size: var(--text-2xl);
    letter-spacing: -0.02em;
  }

  .article__meta {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .article__meta span + span::before {
    content: '·';
    margin-inline: var(--space-2);
  }

  .faq__item {
    padding-block: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .faq__item h3 {
    font-size: var(--text-md);
    font-weight: var(--weight-semibold);
  }

  .faq__item p {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
  }

  .history ol {
    display: grid;
    gap: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .history time {
    margin-right: var(--space-2);
    font-variant-numeric: tabular-nums;
  }
</style>
