---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/layout.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import JsonLd from '../components/JsonLd.astro';
import { isProduction } from '../config/env';
import { site } from '../config/site';
import { absoluteUrl, pageTitle } from '../lib/seo';

export interface Props {
  title?: string;
  description?: string;
  // 페이지별 색인·canonical 정책은 04-seo-rules.md를 따른다. production이 아닌 환경은 항상 noindex.
  noindex?: boolean;
  canonical?: boolean;
  // Open Graph 유형: 글 상세는 article
  ogType?: 'website' | 'article';
  // 페이지별 JSON-LD(lib/seo.ts가 만든다). BreadcrumbList는 Breadcrumb 부품이 직접 낸다
  jsonLd?: object[];
  // 공유 미리보기 이미지(public/ 경로, 1200x630 PNG). 없으면 사이트 기본 이미지
  image?: string;
}

const { title, description = site.description, noindex = false, canonical = true, ogType = 'website', jsonLd = [], image = site.ogImage } = Astro.props;
const fullTitle = pageTitle(title);
const robotsNoindex = noindex || !isProduction;
const canonicalUrl = canonical ? absoluteUrl(Astro.url.pathname) : undefined;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {robotsNoindex && <meta name="robots" content="noindex, follow" />}
    {
      canonicalUrl && (
        <>
          <link rel="canonical" href={canonicalUrl} />
          <meta property="og:type" content={ogType} />
          <meta property="og:site_name" content={site.name} />
          <meta property="og:locale" content="ko_KR" />
          <meta property="og:title" content={fullTitle} />
          <meta property="og:description" content={description} />
          <meta property="og:url" content={canonicalUrl} />
          <meta property="og:image" content={absoluteUrl(image)} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta name="twitter:card" content="summary_large_image" />
        </>
      )
    }
    {jsonLd.map((data) => <JsonLd data={data} />)}
    <meta name="google-site-verification" content={site.verification.google} />
    <meta name="naver-site-verification" content={site.verification.naver} />
    <meta name="google-adsense-account" content={site.adsenseClient} />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {
      isProduction && (
        <>
          <script is:inline define:vars={{ ga4Id: site.ga4Id }}>
            // 검색어(q)는 GA4로 보내지 않는다. GA가 읽기 전에 주소에서 q만 지우고(다른 파라미터 유지) 값은 이 기록 항목의
            // history.state로 옮긴다(검색 페이지가 읽는다). 그래서 page_location·이후 페이지의 page_referrer에 검색어가 없다.
            const url = new URL(location.href);
            if (url.searchParams.has('q')) {
              const q = url.searchParams.get('q');
              url.searchParams.delete('q');
              history.replaceState({ q }, '', url.href);
            }
            window.dataLayer = window.dataLayer || [];
            window.gtag = function () {
              window.dataLayer.push(arguments);
            };
            window.gtag('js', new Date());
            window.gtag('config', ga4Id);
            // 클릭 측정(02 1-E Action·Continue). 보내는 값은 이벤트 이름과 우리 사이트 글 경로(pathname)·위치 번호뿐이다.
            // 링크 글자·query·hash·검색어·계산기 입력값은 보내지 않는다. 기본 click만 본다(가운데 버튼 auxclick은 제외).
            document.addEventListener('click', (e) => {
              if (!(e.target instanceof Element)) return;
              // 공식 신청 버튼 클릭(지원·혜택 글)
              if (e.target.closest('[data-official-cta]')) {
                window.gtag('event', 'official_cta_click');
                return;
              }
              const a = e.target.closest('a[href]');
              if (!a) return;
              const area = a.closest('[data-track]');
              if (!area) return;
              let url;
              try {
                url = new URL(a.getAttribute('href'), location.href);
              } catch {
                return;
              }
              // 같은 사이트의 다른 페이지만(이미지 확대·같은 페이지 안 이동 제외)
              if (url.origin !== location.origin || url.pathname.startsWith('/images/') || url.pathname === location.pathname) return;
              const link_path = url.pathname;
              if (area.dataset.track === 'related') {
                const list = area.querySelector('.card-list');
                const card = list && [...list.children].find((c) => c.contains(a));
                const pos = card ? [...list.children].indexOf(card) + 1 : 0;
                window.gtag('event', 'related_click', pos >= 1 && pos <= 3 ? { link_path, link_position: pos } : { link_path });
              } else if (area.dataset.track === 'body') {
                window.gtag('event', 'internal_link_click', { link_path });
              }
            });
            // 계산기 사용: 계산기는 GA를 모르고 'kkultip:tool-use' 신호만 보낸다. 허용된 이름이 자기 계산기 페이지에서 왔을 때만,
            // 페이지당 이름별 1번만 보낸다(입력·결과 값 없음). 이름·경로 목록은 tools/test-tracking.mjs가 계산기 글과 대조한다
            const toolPages = { 'electricity-bill': '/living/electricity-bill-calculator/', 'mvno-plan-cost': '/digital/mvno-plan-comparison/' };
            const toolSent = new Set();
            document.addEventListener('kkultip:tool-use', (e) => {
              const tool_name = e.detail;
              if (typeof tool_name !== 'string' || !Object.hasOwn(toolPages, tool_name)) return;
              if (toolPages[tool_name] !== location.pathname || toolSent.has(tool_name)) return;
              toolSent.add(tool_name);
              window.gtag('event', 'tool_use', { tool_name });
            });
            // 글 끝 평가(ArticleFeedback): GA4가 있을 때만 보이고, 한 번만 누를 수 있다. 이벤트 이름만 보낸다(숫자를 화면에 보여주지 않음)
            document.addEventListener('DOMContentLoaded', () => {
              const box = document.querySelector('[data-feedback]');
              if (!box) return;
              box.hidden = false;
              const buttons = box.querySelectorAll('[data-feedback-value]');
              buttons.forEach((btn) =>
                btn.addEventListener('click', () => {
                  window.gtag('event', btn.dataset.feedbackValue === 'helpful' ? 'feedback_helpful' : 'feedback_not_helpful');
                  buttons.forEach((b) => (b.disabled = true));
                  btn.setAttribute('aria-pressed', 'true');
                  box.querySelector('[data-feedback-thanks]').textContent = '의견 감사합니다';
                }),
              );
            });
          </script>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${site.ga4Id}`} />
        </>
      )
    }
    <!-- JavaScript가 꺼져 있으면 스크립트로만 동작하는 UI(계산기 입력 등)를 숨긴다 -->
    <noscript><style>[data-js-only]{display:none!important}</style></noscript>
  </head>
  <body>
    <a class="skip-link" href="#main">본문 바로가기</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
