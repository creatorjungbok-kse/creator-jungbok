---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/layout.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import JsonLd from '../components/JsonLd.astro';
import { isProduction } from '../config/env';
import { site } from '../config/site';
import { absoluteUrl, pageTitle } from '../lib/seo';

export interface Props {
  title?: string;
  description?: string;
  // 페이지별 색인·canonical 정책은 04-seo-rules.md를 따른다. production이 아닌 환경은 항상 noindex.
  noindex?: boolean;
  canonical?: boolean;
  // Open Graph 유형: 글 상세는 article
  ogType?: 'website' | 'article';
  // 페이지별 JSON-LD(lib/seo.ts가 만든다). BreadcrumbList는 Breadcrumb 부품이 직접 낸다
  jsonLd?: object[];
  // 공유 미리보기 이미지(public/ 경로, 1200x630 PNG). 없으면 사이트 기본 이미지
  image?: string;
}

const { title, description = site.description, noindex = false, canonical = true, ogType = 'website', jsonLd = [], image = site.ogImage } = Astro.props;
const fullTitle = pageTitle(title);
const robotsNoindex = noindex || !isProduction;
const canonicalUrl = canonical ? absoluteUrl(Astro.url.pathname) : undefined;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {robotsNoindex && <meta name="robots" content="noindex, follow" />}
    {
      canonicalUrl && (
        <>
          <link rel="canonical" href={canonicalUrl} />
          <meta property="og:type" content={ogType} />
          <meta property="og:site_name" content={site.name} />
          <meta property="og:locale" content="ko_KR" />
          <meta property="og:title" content={fullTitle} />
          <meta property="og:description" content={description} />
          <meta property="og:url" content={canonicalUrl} />
          <meta property="og:image" content={absoluteUrl(image)} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta name="twitter:card" content="summary_large_image" />
        </>
      )
    }
    {jsonLd.map((data) => <JsonLd data={data} />)}
    <meta name="google-site-verification" content={site.verification.google} />
    <meta name="naver-site-verification" content={site.verification.naver} />
    <meta name="google-adsense-account" content={site.adsenseClient} />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {
      isProduction && (
        <>
          <script is:inline define:vars={{ ga4Id: site.ga4Id }}>
            // 검색어(q)는 GA4로 보내지 않는다. GA가 읽기 전에 주소에서 q만 지우고(다른 파라미터 유지) 값은 이 기록 항목의
            // history.state로 옮긴다(검색 페이지가 읽는다). 그래서 page_location·이후 페이지의 page_referrer에 검색어가 없다.
            const url = new URL(location.href);
            if (url.searchParams.has('q')) {
              const q = url.searchParams.get('q');
              url.searchParams.delete('q');
              history.replaceState({ q }, '', url.href);
            }
            window.dataLayer = window.dataLayer || [];
            window.gtag = function () {
              window.dataLayer.push(arguments);
            };
            window.gtag('js', new Date());
            window.gtag('config', ga4Id);
            // 공식 신청 버튼 클릭(지원·혜택 글). 페이지 주소 외의 값은 보내지 않는다
            document.addEventListener('click', (e) => {
              if (e.target instanceof Element && e.target.closest('[data-official-cta]')) window.gtag('event', 'official_cta_click');
            });
          </script>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${site.ga4Id}`} />
        </>
      )
    }
    <!-- JavaScript가 꺼져 있으면 스크립트로만 동작하는 UI(계산기 입력 등)를 숨긴다 -->
    <noscript><style>[data-js-only]{display:none!important}</style></noscript>
  </head>
  <body>
    <a class="skip-link" href="#main">본문 바로가기</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
