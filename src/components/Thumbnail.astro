---
// 글 대표 이미지(16:9, public/images/thumbnails/의 로컬 파일). 이미지가 없는 글은 대분류 이름을 쓴 색 칸으로 대신한다.
// 칸 비율을 CSS로 먼저 잡아 두므로 이미지가 늦게 와도 레이아웃이 움직이지 않는다(CLS 0).
// 장식용이다(제목이 바로 옆에 HTML 글자로 있다): alt="" + 대체 칸은 aria-hidden.
export interface Props {
  src?: string;
  // 대체 칸에 쓰는 대분류 이름·slug(색)
  label: string;
  tone: string;
  // 첫 화면의 대표 이미지만 true(그 밖은 화면에 가까워질 때 불러온다)
  eager?: boolean;
  class?: string;
}

const { src, label, tone, eager = false, class: className } = Astro.props;
---

<div class:list={['thumb', `thumb--${tone}`, className]}>
  {
    src ? (
      <img src={src} alt="" width="640" height="360" loading={eager ? 'eager' : 'lazy'} decoding="async" />
    ) : (
      <span aria-hidden="true">{label}</span>
    )
  }
</div>

<style>
  .thumb {
    display: grid;
    place-items: center;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-sm);
    background: var(--color-surface);
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* 대체 칸: 대분류별 옅은 색 + 이름 */
  .thumb span {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  .thumb--business {
    background: var(--color-tone-business);
  }

  .thumb--living {
    background: var(--color-tone-living);
  }

  .thumb--digital {
    background: var(--color-tone-digital);
  }
</style>
