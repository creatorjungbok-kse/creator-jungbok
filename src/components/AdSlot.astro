---
import { adsEnabled, type AdSlotId } from '../config/ads';

export interface Props {
  id: AdSlotId;
}

// 광고가 꺼져 있으면 아무것도(요소·CSS) 출력하지 않는다. 켜지면 CLS 방지용 예약 높이(tokens.css·layout.css의 --ad-min-h)를
// 가진 빈 자리만 낸다(광고 코드 없음).
const { id } = Astro.props;
---

{adsEnabled && <div data-ad-slot={id} style="min-height: var(--ad-min-h)"></div>}
