---
import { site } from '../config/site';
import { categoryHref } from '../data/categories';
import { primaryNavCategories } from '../lib/content';

const path = Astro.url.pathname;
// 공개 글이 노출 기준(primaryNavMinPosts, 기본 1) 미만인 대분류는 메뉴에 두지 않는다(lib/content.ts primaryNavCategories)
const navCategories = await primaryNavCategories();
// 헤더 검색(01 B): 검색 페이지는 자체 검색창이 있으므로 숨긴다(홈도 2026-10-26 B안부터 헤더 검색 사용). JavaScript 없이 /search/로 이동한다
const showSearch = path !== '/search/';
---

<header class="site-header">
  <div class="container site-header__inner">
    <button class="menu-button" type="button" popovertarget="site-nav" aria-label="카테고리 메뉴">
      <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
      </svg>
    </button>
    <a class="logo" href="/">{site.name}</a>
    <div class="site-header__tools">
      {
        showSearch && (
          <>
            <form class="header-search" action="/search/" method="get" role="search">
              <label class="visually-hidden" for="header-q">검색어</label>
              <input id="header-q" name="q" type="search" placeholder="궁금한 정보 검색" autocomplete="off" />
              <button type="submit" aria-label="검색">
                <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"></circle>
                  <path d="m20 20-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
                </svg>
              </button>
            </form>
            <a class="search-link" href="/search/" aria-label="검색">
              <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"></circle>
                <path d="m20 20-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
              </svg>
            </a>
          </>
        )
      }
    </div>
  </div>
  <div class="site-header__navbar container">
    <nav id="site-nav" class="site-nav" popover aria-label="카테고리">
      <a href="/" aria-current={path === '/' ? 'page' : undefined}>홈</a>
      {
        navCategories.map((c) => (
          <a href={categoryHref(c)} aria-current={path.startsWith(categoryHref(c)) ? 'page' : undefined}>
            {c.name}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  /* 매거진형 헤더(Astro News 템플릿 방식): 위 줄 가운데 로고, 아래 줄 가운데 카테고리 메뉴 */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-3);
    height: var(--header-top-h);
  }

  .logo {
    display: inline-flex;
    align-items: center;
    justify-self: center;
    gap: var(--space-2);
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    letter-spacing: -0.03em;
  }

  .logo::before {
    content: '';
    width: 16px;
    height: 16px;
    border-radius: 4px;
    background: var(--color-brand);
  }

  .logo:hover {
    text-decoration: none;
  }

  .site-header__tools {
    display: flex;
    justify-content: flex-end;
  }

  .search-link {
    display: grid;
    place-items: center;
    width: var(--touch);
    height: var(--touch);
    margin-right: calc(-1 * var(--space-3));
  }

  .header-search {
    display: none;
    align-items: center;
    padding-left: var(--space-4);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
  }

  .header-search input {
    width: 12rem;
    min-height: 40px;
    border: 0;
    background: transparent;
    font: inherit;
    font-size: var(--text-sm);
  }

  .header-search button {
    display: grid;
    place-items: center;
    width: 40px;
    min-height: 40px;
    border: 0;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
  }

  .menu-button {
    justify-self: start;
    place-items: center;
    width: var(--touch);
    height: var(--touch);
    margin-left: calc(-1 * var(--space-3));
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }

  .site-nav a {
    display: flex;
    align-items: center;
    min-height: var(--touch);
    padding-inline: var(--space-3);
    font-weight: var(--weight-medium);
  }

  .site-nav a:hover {
    text-decoration: none;
    background: var(--color-surface);
  }

  .site-nav a[aria-current='page'] {
    border-radius: var(--radius-sm);
    background: var(--color-brand-soft);
    font-weight: var(--weight-bold);
  }

  @media (min-width: 768px) {
    .site-header__navbar {
      border-top: 1px solid var(--color-border);
    }

    .site-nav[popover] {
      justify-content: center;
      gap: var(--space-2);
    }

    .site-nav a {
      min-height: var(--header-nav-h);
      font-size: var(--text-sm);
    }

    .site-nav a:hover {
      background: none;
      color: var(--color-brand-text);
    }

    .site-nav a[aria-current='page'] {
      border-radius: 0;
      background: none;
      box-shadow: inset 0 -3px 0 var(--color-brand);
    }
  }

  @media (min-width: 1024px) {
    .search-link {
      display: none;
    }

    .header-search {
      display: flex;
    }
  }
</style>
