---
import { site } from '../config/site';
import { categories, categoryHref } from '../data/categories';

const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="logo" href="/">{site.name}</a>
    <button class="menu-button" type="button" popovertarget="site-nav" aria-label="카테고리 메뉴">
      <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
      </svg>
    </button>
    <nav id="site-nav" class="site-nav" popover aria-label="카테고리">
      {
        categories.map((c) => (
          <a href={categoryHref(c)} aria-current={path.startsWith(categoryHref(c)) ? 'page' : undefined}>
            {c.name}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    height: var(--header-h);
  }

  .logo {
    font-size: var(--text-lg);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .menu-button {
    place-items: center;
    width: var(--touch);
    height: var(--touch);
    margin-right: calc(-1 * var(--space-3));
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }

  .site-nav a {
    display: flex;
    align-items: center;
    min-height: var(--touch);
    padding-inline: var(--space-3);
    font-weight: 600;
  }

  .site-nav a[aria-current='page'] {
    color: var(--color-accent);
  }
</style>
