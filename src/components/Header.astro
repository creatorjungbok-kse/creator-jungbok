---
import { site } from '../config/site';
import { categories, categoryHref } from '../data/categories';

const path = Astro.url.pathname;
// 헤더 검색(01 B): 홈은 Hero 검색창, 검색 페이지는 자체 검색창이 있으므로 숨긴다. JavaScript 없이 /search/로 이동한다
const showSearch = path !== '/' && path !== '/search/';
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="logo" href="/">{site.name}</a>
    {
      showSearch && (
        <>
          <form class="header-search" action="/search/" method="get" role="search">
            <label class="visually-hidden" for="header-q">검색어</label>
            <input id="header-q" name="q" type="search" placeholder="궁금한 정보 검색" autocomplete="off" />
            <button type="submit" aria-label="검색">
              <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"></circle>
                <path d="m20 20-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
              </svg>
            </button>
          </form>
          <a class="search-link" href="/search/" aria-label="검색">
            <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"></circle>
              <path d="m20 20-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
            </svg>
          </a>
        </>
      )
    }
    <button class="menu-button" type="button" popovertarget="site-nav" aria-label="카테고리 메뉴">
      <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
      </svg>
    </button>
    <nav id="site-nav" class="site-nav" popover aria-label="카테고리">
      {
        categories.map((c) => (
          <a href={categoryHref(c)} aria-current={path.startsWith(categoryHref(c)) ? 'page' : undefined}>
            {c.name}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    height: var(--header-h);
  }

  .logo {
    margin-right: auto;
    font-size: var(--text-lg);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  /* 헤더 검색: 1024px 미만은 아이콘 링크(/search/), 이상은 입력창.
     모바일은 [🔍][☰], 태블릿 이상은 카테고리 메뉴 뒤(order) */
  .search-link {
    display: grid;
    place-items: center;
    width: var(--touch);
    height: var(--touch);
    margin-right: calc(-1 * var(--space-3));
  }

  .header-search {
    display: none;
    order: 1;
  }

  .header-search input {
    width: 12rem;
    min-height: 40px;
    padding-inline: var(--space-3);
    border: 1px solid var(--color-border);
    border-right: 0;
    border-radius: var(--radius) 0 0 var(--radius);
    font: inherit;
    font-size: var(--text-sm);
  }

  .header-search button {
    display: grid;
    place-items: center;
    width: 40px;
    min-height: 40px;
    border: 1px solid var(--color-border);
    border-radius: 0 var(--radius) var(--radius) 0;
    background: var(--color-surface);
    color: inherit;
    cursor: pointer;
  }

  @media (min-width: 768px) {
    .search-link {
      order: 1;
    }
  }

  @media (min-width: 1024px) {
    .search-link {
      display: none;
    }

    .header-search {
      display: flex;
    }
  }

  .menu-button {
    place-items: center;
    width: var(--touch);
    height: var(--touch);
    margin-right: calc(-1 * var(--space-3));
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }

  .site-nav a {
    display: flex;
    align-items: center;
    min-height: var(--touch);
    padding-inline: var(--space-3);
    font-weight: 600;
  }

  .site-nav a[aria-current='page'] {
    color: var(--color-accent);
  }
</style>
