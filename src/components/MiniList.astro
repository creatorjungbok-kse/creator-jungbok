---
import SectionTitle, { type Props as SectionTitleProps } from './SectionTitle.astro';

export interface Props {
  title: string;
  tier?: SectionTitleProps['tier'];
  items: { href: string; title: string; meta?: string }[];
  class?: string;
}

const { title, tier = 'utility', items, class: className } = Astro.props;
---

<section class={className}>
  <SectionTitle title={title} tier={tier} />
  <ol class="mini-list">
    {
      items.map((item) => (
        <li>
          <a href={item.href}>{item.title}</a>
          {item.meta && <span>{item.meta}</span>}
        </li>
      ))
    }
  </ol>
</section>

<style>
  li {
    display: grid;
    gap: 2px;
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-border);
    font-size: var(--text-sm);
  }

  li:first-child {
    padding-top: 0;
  }

  a {
    font-weight: 600;
  }

  span {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

</style>
