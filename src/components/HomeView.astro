---
// 홈 화면. 섹션별 목록 선택은 src/pages/index.astro(lib/select.ts 규칙)에서 하고, 여기서는 표시만 한다.
// 순서: 짧은 소개·검색 → 대표 글(큰 1 + 작은 2) → 신청 가능한 지원 → 최근 글 피드 / 사이드바(카테고리·도구).
// 항목이 없는 섹션은 숨긴다(01 D). 콘텐츠가 하나도 없으면 준비 중 안내를 보여 준다.
import AdSlot from './AdSlot.astro';
import BlogSidebar from './BlogSidebar.astro';
import ContentCard from './ContentCard.astro';
import MiniList from './MiniList.astro';
import SectionTitle from './SectionTitle.astro';
import { site } from '../config/site';
import type { ContentItem } from '../lib/content';

export interface Props {
  // 3개 = 큰 카드 1 + 작은 카드 2 / 2개 = 같은 크기 2칸 / 1개 = 가로 카드 1
  featured: ContentItem[];
  benefits: ContentItem[];
  timely: ContentItem[];
  recent: ContentItem[];
  isEmpty: boolean;
}

const { featured, benefits, timely, recent, isEmpty } = Astro.props;
const links = (items: ContentItem[]) => items.map((i) => ({ href: i.url, title: i.entry.data.title }));
const [lead, ...side] = featured;
---

<div class="container page-grid">
  <div class="page-main">
    <section class="hero">
      <h1>{site.tagline}</h1>
      <p>공식 자료를 먼저 확인하고, 확인한 날짜를 함께 적습니다.</p>
      <form class="search-form" action="/search/" method="get" role="search">
        <label class="visually-hidden" for="home-q">검색어</label>
        <input id="home-q" name="q" type="search" placeholder="예: 전기요금 계산기, 사업자등록증" />
        <button type="submit">검색</button>
      </form>
    </section>

    {isEmpty && <p class="empty">첫 정보를 준비하고 있습니다. 아래 카테고리에서 다룰 주제를 확인해 보세요.</p>}

    {
      featured.length > 0 && (
        <section>
          <SectionTitle title="먼저 읽어 볼 가이드" tier="primary" />
          {featured.length === 3 ? (
            <div class="featured featured--3">
              <ContentCard item={lead} variant="feature" eager />
              <div class="featured__side">
                {side.map((item) => (
                  <ContentCard item={item} variant="stack" />
                ))}
              </div>
            </div>
          ) : featured.length === 2 ? (
            <div class="featured featured--2">
              {featured.map((item, i) => (
                <ContentCard item={item} variant="feature" eager={i === 0} />
              ))}
            </div>
          ) : (
            <ContentCard item={lead} variant="row" eager />
          )}
        </section>
      )
    }

    {
      benefits.length > 0 && (
        <section data-open-list>
          <SectionTitle title="지금 신청 가능한 지원·혜택" href="/benefits/" tier="primary" />
          <div class="card-grid">
            {benefits.map((item) => (
              <ContentCard item={item} />
            ))}
          </div>
        </section>
      )
    }

    {timely.length > 0 && <MiniList title="최근 확인할 돈 정보" items={links(timely)} tier="secondary" />}

    {recent.length > 0 && <AdSlot id="home-1" />}

    {
      recent.length > 0 && (
        <section>
          <SectionTitle title="최근 글" tier="primary" />
          <div class="card-list">
            {recent.map((item) => (
              <ContentCard item={item} variant="row" />
            ))}
          </div>
        </section>
      )
    }
  </div>

  <aside class="page-aside" aria-label="카테고리와 도구">
    {
      benefits.length > 0 && (
        <div class="desktop-only" data-open-list>
          <MiniList title="지원·혜택 바로가기" items={links(benefits)} />
        </div>
      )
    }
    <BlogSidebar showRecent={false} />
  </aside>
</div>

<style>
  /* 짧은 소개 + 검색: 첫 화면에서 대표 글이 바로 보이도록 낮게 */
  .hero {
    display: grid;
    /* 좁은 화면(360px 미만)에서 검색창이 칸을 밀어내지 않게 */
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-2);
  }

  .hero h1 {
    font-size: var(--text-xl);
    letter-spacing: -0.02em;
  }

  .hero p {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .hero .search-form {
    margin-top: var(--space-2);
  }

  .featured,
  .featured__side {
    display: grid;
    gap: var(--space-5);
  }

  /* 모바일: 작은 대표 글은 이미지 왼쪽 + 제목 */
  .featured__side > :global(.card) {
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: var(--space-4);
  }

  @media (min-width: 768px) {
    .hero h1 {
      font-size: var(--text-2xl);
    }

    .featured--3 {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    }

    .featured__side > :global(.card) {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-3);
    }

    .featured--2 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
