---
// 홈 화면(B안 매거진형). 목록 선택은 src/pages/index.astro(lib/select.ts 규칙)에서 하고, 여기서는 표시만 한다.
// 순서: 대표 글 + 요즘 많이 찾는 글 → [본문] 최신 글 → [광고] → 지금 확인할 혜택 → 계산기 → 분야별 다른 글 → 조사 원칙
//       [사이드바] 운영자 → 인기 글 → 카테고리·계산기(BlogSidebar)
// 한 글은 홈에서 한 번만 보이고, 항목이 없는 섹션은 숨긴다. 슬라이더·움직이는 요소 없음.
import AdSlot from './AdSlot.astro';
import AuthorBox from './AuthorBox.astro';
import BlogSidebar from './BlogSidebar.astro';
import ContentCard from './ContentCard.astro';
import Icon from './Icon.astro';
import SectionTitle from './SectionTitle.astro';
import { site } from '../config/site';
import type { Category } from '../data/categories';
import type { ContentItem } from '../lib/content';
import { formatDate } from '../lib/format';

export interface Props {
  lead?: ContentItem;
  trending: ContentItem[];
  popular: ContentItem[];
  latest: ContentItem[];
  urgent: ContentItem[];
  moreUrgent: boolean;
  tools: { href: string; name: string; summary?: string }[];
  sections: { category: Category; href: string; count: number; items: ContentItem[] }[];
  isEmpty: boolean;
}

const { lead, trending, popular, latest, urgent, moreUrgent, tools, sections, isEmpty } = Astro.props;
---

<div class="home">
  <div class="container home-lead">
    <h1 class="home-title"><strong>{site.name}</strong> · 정부·공공기관 공식 자료로 확인한 생활 돈 정보</h1>
    {isEmpty && <p class="empty">첫 정보를 준비하고 있습니다.</p>}
    {
      lead && (
        <div class="lead-grid">
          <div class="lead-main">
            <ContentCard item={lead} variant="feature" eager label="main" />
          </div>
          {trending.length > 0 && (
            <section class="lead-side" aria-labelledby="trending-title">
              <h2 id="trending-title">요즘 많이 찾는 글</h2>
              <div class="lead-list">
                {trending.map((item) => (
                  <ContentCard item={item} variant="mini" short />
                ))}
              </div>
            </section>
          )}
        </div>
      )
    }
  </div>

  <div class="container page-grid">
    <div class="page-main home__body">
      {
        latest.length > 0 && (
          <section class="block">
            <SectionTitle title="최신 글" tier="primary" />
            <div class="latest">
              {latest.map((item) => (
                <ContentCard item={item} variant="tile" short label="main" />
              ))}
            </div>
          </section>
        )
      }

      {latest.length > 0 && <AdSlot id="home-1" />}

      {
        urgent.length > 0 && (
          <section class="block" data-open-list>
            <SectionTitle title="지금 확인할 혜택" tier="primary" />
            <p class="block__note">마감이 가까운 혜택, 7일 안에 신청이 시작되는 혜택, 지금 신청할 수 있는 혜택 순서입니다.</p>
            <div class="card-grid">
              {urgent.map((item) => (
                <ContentCard item={item} short />
              ))}
            </div>
            <a class="more-link" href="/benefits/">
              {moreUrgent ? '지금 확인할 혜택 더 보기' : '지원·혜택 전체 보기'} <span aria-hidden="true">›</span>
            </a>
          </section>
        )
      }

      {
        tools.length > 0 && (
          <section class="block">
            <SectionTitle title="바로 쓰는 계산기" tier="primary" />
            <ul class="tools">
              {tools.map((t) => (
                <li>
                  <a href={t.href}>
                    <span class="tools__name">{t.name}</span>
                    {t.summary && <span class="tools__desc">{t.summary}</span>}
                    <span class="tools__go">
                      계산하기 <span aria-hidden="true">›</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        sections.some((s) => s.items.length > 0) && (
          <section class="block">
            <SectionTitle title="분야별로 보기" tier="primary" />
            <div class="by-cat">
              {sections
                .filter(({ items }) => items.length > 0)
                .map(({ category, href, count, items }) => (
                  <section class="by-cat__col" aria-labelledby={`latest-${category.slug}`}>
                    <div class="by-cat__head">
                      <h3 id={`latest-${category.slug}`}>{category.name}</h3>
                      <a href={href}>
                        글 {count}개 전체 보기 <span aria-hidden="true">›</span>
                      </a>
                    </div>
                    <ol>
                      {items.map((item) => (
                        <li>
                          <a href={item.url}>{item.entry.data.cardTitle ?? item.entry.data.title}</a>
                          <span>업데이트 {formatDate(item.entry.data.dateModified)}</span>
                        </li>
                      ))}
                    </ol>
                  </section>
                ))}
            </div>
          </section>
        )
      }

      <section class="method" aria-labelledby="method-title">
        <h2 id="method-title">정보는 이렇게 조사합니다</h2>
        <p>
          {site.name}은 지원·혜택, 사업·창업, 근로·급여, 집·생활, 통신·디지털, 금융·저축 분야의 생활 정보를 다룹니다. 모든 글은 정부·공공기관 같은
          공식 자료를 먼저 확인하고, 확인한 날짜와 바뀐 내용을 글마다 남깁니다.
        </p>
        <ul class="trust">
          <li><Icon name="check" size={18} /> 공식 출처만 사용</li>
          <li><Icon name="check" size={18} /> 확인 날짜 표시</li>
          <li><Icon name="check" size={18} /> 변경 내역 공개</li>
        </ul>
        <a class="method__link" href="/editorial-policy/">정보 조사 원칙 자세히 보기 <span aria-hidden="true">›</span></a>
      </section>
    </div>

    <aside class="page-aside" aria-label="운영자와 카테고리">
      <AuthorBox />
      {
        popular.length > 0 && (
          <section class="side-block popular">
            <SectionTitle title="인기 글" tier="utility" />
            <ol>
              {popular.map((item) => (
                <li>
                  <a href={item.url}>{item.entry.data.cardTitle ?? item.entry.data.title}</a>
                </li>
              ))}
            </ol>
          </section>
        )
      }
      <BlogSidebar showRecent={false} />
    </aside>
  </div>
</div>

<style>
  /* 첫 화면: 대표 글(큰 이미지) + 요즘 많이 찾는 글. 모바일은 위아래로 */
  .home-lead {
    display: grid;
    gap: var(--space-4);
    padding-top: var(--space-5);
  }

  .home-title {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  .home-title strong {
    color: var(--color-text);
  }

  .lead-grid {
    display: grid;
    gap: var(--space-6);
  }

  .lead-main :global(.card--feature .card__title) {
    font-size: var(--text-xl);
  }

  .lead-side h2 {
    margin-bottom: var(--space-2);
    font-size: var(--text-lg);
  }

  .lead-list > :global(.card) {
    grid-template-columns: 7.5rem minmax(0, 1fr);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .lead-list :global(.card__title) {
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
  }

  /* 최신 글: 이미지 카드 모바일 2칸, 태블릿 이상 3칸 */
  .latest {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5) var(--space-4);
  }

  .latest :global(.card__title) {
    font-size: var(--text-sm);
  }

  .home .page-grid {
    padding-top: var(--space-6);
  }

  /* 사이드바 인기 글: 번호 + 제목 */
  .popular ol {
    counter-reset: pop;
  }

  .popular li {
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr);
    padding-block: var(--space-3);
    border-bottom: 1px dashed var(--color-border);
    counter-increment: pop;
    font-size: var(--text-sm);
  }

  .popular li::before {
    content: counter(pop, decimal-leading-zero);
    color: var(--color-brand);
    font-weight: var(--weight-bold);
  }

  .popular a {
    color: var(--color-text);
    text-decoration: none;
  }

  .popular a:hover {
    text-decoration: underline;
  }

  @media (min-width: 768px) {
    .latest {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-6) var(--space-5);
    }

    .latest :global(.card__title) {
      font-size: var(--text-base);
    }

    .lead-main :global(.card--feature .card__title) {
      font-size: var(--text-2xl);
    }
  }

  @media (min-width: 1024px) {
    .lead-grid {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
      gap: var(--gap-layout);
    }
  }

  .home__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--section-gap);
    padding-block: var(--space-6) var(--space-7);
  }

  /* 소개·검색: 옅은 바탕 띠로 본문과 구분. 모바일 첫 300px 안에 검색창, 이미지 없음 */






  /* 지금 확인할 혜택: 고르는 기준 한 줄 + 전체 보기 */
  .block__note {
    margin-top: calc(-1 * var(--space-2));
    margin-bottom: var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .more-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch);
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  .cats + .by-cat {
    margin-top: var(--space-6);
  }

  /* 대분류 4개: 모바일 2칸, 태블릿 이상 4칸. 분야 색은 썸네일과 같은 톤 */
  .cats ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
  }

  .cat a {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    height: 100%;
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-top: 4px solid var(--tone, var(--color-brand));
    border-radius: var(--radius);
    color: var(--color-text);
    text-decoration: none;
  }

  .cat a:hover {
    border-color: var(--color-outline);
    border-top-color: var(--tone, var(--color-brand));
  }

  .cat--benefits {
    --tone: var(--color-status-open);
  }

  .cat--business {
    --tone: var(--color-brand);
  }

  .cat--living {
    --tone: var(--color-link);
  }

  .cat--digital {
    --tone: var(--color-brand-text);
  }

  .cat__name {
    font-size: var(--text-md);
    font-weight: var(--weight-bold);
  }

  .cat__desc {
    display: none;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .cat__count {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  /* 계산기: 이름 + 한 줄 설명 + 바로 쓰기 */
  .tools {
    display: grid;
    gap: var(--space-3);
  }

  .tools a {
    display: grid;
    gap: var(--space-2);
    height: 100%;
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    color: var(--color-text);
    text-decoration: none;
  }

  .tools a:hover {
    border-color: var(--color-outline);
  }

  .tools__name {
    font-weight: var(--weight-bold);
  }

  .tools__desc {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .tools__go {
    color: var(--color-link);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  /* 새로 올라온 글: 모바일은 작은 이미지 왼쪽 + 제목(세로로 길어지지 않게), 태블릿 이상은 이미지 카드 3칸 */
  @media (max-width: 767.98px) {
    .picks > :global(.card) {
      grid-template-columns: 7.5rem minmax(0, 1fr);
      gap: var(--space-4);
    }

    .picks :global(.card--feature .card__title) {
      font-size: var(--text-base);
    }

    .picks :global(.card__excerpt) {
      display: none;
    }
  }

  /* 분야별 최신 글: 모바일 1칸, 태블릿 이상 2칸(본문 칸 안) */
  .by-cat {
    display: grid;
    gap: var(--space-6);
  }

  .by-cat__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 2px solid var(--color-text);
  }

  .by-cat__head h3 {
    font-size: var(--text-md);
  }

  .by-cat__head a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch);
    margin-block: calc(-1 * var(--space-3));
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .by-cat ol li {
    display: grid;
    gap: 2px;
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .by-cat ol a {
    color: var(--color-text);
    font-weight: var(--weight-semibold);
    text-decoration: none;
  }

  .by-cat ol a:hover {
    text-decoration: underline;
  }

  .by-cat ol span {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  /* 조사 원칙: 페이지 끝 신뢰 구획 */
  .method {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-5);
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .method h2 {
    font-size: var(--text-lg);
  }

  .method p {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .trust {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  .trust li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .trust :global(.icon) {
    color: var(--color-status-open);
  }

  .method__link {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    min-height: var(--touch);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  @media (min-width: 768px) {
    .cats ul {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .cat__desc {
      display: -webkit-box;
      overflow: hidden;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
    }

    .tools {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .by-cat {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-6) var(--space-7);
    }
  }

  @media (min-width: 1024px) {

    .method {
      padding: var(--space-6);
    }
  }
</style>
