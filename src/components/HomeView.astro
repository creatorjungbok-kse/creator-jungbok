---
// 홈 화면. 섹션별 목록 선택은 src/pages/index.astro(lib/select.ts 규칙)에서 하고, 여기서는 표시만 한다.
// 항목이 없는 섹션은 숨긴다(01 D). 콘텐츠가 하나도 없으면 준비 중 안내를 보여 준다.
import AdSlot from './AdSlot.astro';
import ContentCard from './ContentCard.astro';
import MiniList from './MiniList.astro';
import SectionTitle from './SectionTitle.astro';
import UpdateList from './UpdateList.astro';
import { site } from '../config/site';
import { categories, categoryHref, categoryLinks } from '../data/categories';
import type { ContentItem } from '../lib/content';

export interface Props {
  // 첫 항목은 큰 카드, 나머지 2개는 작은 카드
  featured: ContentItem[];
  benefits: ContentItem[];
  costs: ContentItem[];
  timely: ContentItem[];
  byCategory: Record<string, ContentItem[]>;
  recent: ContentItem[];
  updates: ContentItem[];
  isEmpty: boolean;
}

const { featured, benefits, costs, timely, byCategory, recent, updates, isEmpty } = Astro.props;
const links = (items: ContentItem[]) => items.map((i) => ({ href: i.url, title: i.entry.data.title }));
const isoDate = (d: Date) => d.toISOString().slice(0, 10);
---

<div class="container page-grid">
  <div class="page-main">
    <section class="hero">
      <h1>얼마 들고, 얼마 받을 수 있을까요?</h1>
      <p>{site.tagline}</p>
      <form class="search-form" action="/search/" method="get" role="search">
        <label class="visually-hidden" for="home-q">검색어</label>
        <input id="home-q" name="q" type="search" placeholder="예: 입주청소 비용, 근로장려금 신청" />
        <button type="submit">검색</button>
      </form>
    </section>

    {isEmpty && <p class="empty">첫 정보를 준비하고 있습니다. 아래 카테고리에서 다룰 주제를 확인해 보세요.</p>}

    {
      featured.length > 0 && (
        <section aria-labelledby="featured-title">
          <h2 id="featured-title" class="visually-hidden">대표 콘텐츠</h2>
          <div class="featured-grid">
            {featured.map((item, i) => <ContentCard item={item} large={i === 0} />)}
          </div>
        </section>
      )
    }

    {
      benefits.length > 0 && (
        <section data-open-list>
          <SectionTitle title="지금 신청 가능한 지원·혜택" href="/benefits/" tier="primary" />
          <div class="card-grid">
            {benefits.map((item) => (
              <ContentCard item={item} />
            ))}
          </div>
        </section>
      )
    }

    {
      costs.length > 0 && (
        <section>
          <SectionTitle title="최근 조사한 비용" tier="primary" />
          <div class="card-grid">
            {costs.map((item) => (
              <ContentCard item={item} />
            ))}
          </div>
        </section>
      )
    }

    {timely.length > 0 && <MiniList title="최근 확인할 돈 정보" items={links(timely)} tier="secondary" />}

    {(costs.length > 0 || timely.length > 0) && <AdSlot id="home-1" />}

    <section>
      <SectionTitle title="카테고리별 정보" />
      <div class="card-grid">
        {
          categories.map((c) => (
            <section class="category-block">
              <h3>
                <a href={categoryHref(c)}>{c.name}</a>
              </h3>
              <p>{c.description}</p>
              {(byCategory[c.slug] ?? []).length > 0 && (
                <ul>
                  {byCategory[c.slug]?.map((item) => (
                    <li>
                      <a href={item.url}>{item.entry.data.title}</a>
                    </li>
                  ))}
                </ul>
              )}
            </section>
          ))
        }
      </div>
    </section>

    {
      recent.length > 0 && (
        <section>
          <SectionTitle title="최근 글" tier="primary" />
          <div class="card-list">
            {recent.map((item) => (
              <ContentCard item={item} />
            ))}
          </div>
        </section>
      )
    }
  </div>

  <aside class="page-aside" aria-label="보조 정보">
    {updates.length > 0 && <UpdateList title="최근 업데이트" items={updates.map((i) => ({ href: i.url, title: i.entry.data.title, date: isoDate(i.entry.data.dateModified) }))} />}
    {
      benefits.length > 0 && (
        <div class="desktop-only" data-open-list>
          <MiniList title="지원·혜택 바로가기" items={links(benefits)} />
        </div>
      )
    }
    <MiniList class="desktop-only" title="카테고리" items={categoryLinks} />
  </aside>
</div>

<style>
  .hero {
    display: grid;
    /* 좁은 화면(360px 미만)에서 검색창이 칸을 밀어내지 않게 */
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
    padding: clamp(var(--space-5), 4vw, var(--space-6));
    border-radius: var(--radius);
    background: var(--color-accent-soft);
  }

  .hero h1 {
    font-size: clamp(var(--text-xl), 3vw, var(--text-2xl));
    letter-spacing: -0.02em;
  }

  .hero p {
    color: var(--color-text-muted);
  }

  .category-block {
    display: grid;
    align-content: start;
    gap: var(--space-2);
  }

  .category-block h3 {
    font-size: var(--text-md);
  }

  .category-block p {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .category-block ul {
    display: grid;
    gap: var(--space-1);
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-border);
    font-size: var(--text-sm);
  }
</style>
