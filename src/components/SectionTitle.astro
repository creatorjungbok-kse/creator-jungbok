---
export interface Props {
  title: string;
  href?: string;
  // primary: 홈 핵심 섹션 / secondary: 보조 섹션 / utility: 사이드바·목록 제목
  tier?: 'primary' | 'secondary' | 'utility';
}

const { title, href, tier = 'secondary' } = Astro.props;
---

<div class={`section-title section-title--${tier}`}>
  <h2>{title}</h2>
  {href && <a href={href}>전체 보기 <span aria-hidden="true">›</span></a>}
</div>

<style>
  /* M3식 섹션 머리: 선·막대 없이 크기와 굵기로만 위계를 나눈다. '전체 보기'는 오른쪽 보조 글자 */
  .section-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  h2 {
    font-weight: var(--weight-bold);
    letter-spacing: -0.01em;
  }

  /* 터치 영역 44px, 바깥 여백은 음수 margin으로 상쇄 */
  a {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    min-height: var(--touch);
    margin-block: calc(-1 * var(--space-3));
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }

  .section-title--primary h2 {
    font-size: var(--text-lg);
  }

  .section-title--secondary h2 {
    font-size: var(--text-md);
  }

  .section-title--utility {
    margin-bottom: var(--space-2);
  }

  .section-title--utility h2 {
    font-size: var(--text-base);
  }
</style>
