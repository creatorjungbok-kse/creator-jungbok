---
export interface Props {
  title: string;
  href?: string;
  // primary: 홈 핵심 섹션 / secondary: 보조 섹션 / utility: 사이드바·목록 제목
  tier?: 'primary' | 'secondary' | 'utility';
}

const { title, href, tier = 'secondary' } = Astro.props;
---

<div class={`section-title section-title--${tier}`}>
  <h2>{title}</h2>
  {href && <a href={href}>전체 보기 <span aria-hidden="true">›</span></a>}
</div>

<style>
  .section-title {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  h2 {
    font-weight: 700;
  }

  a {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  /* primary·secondary: 전체 폭 얇은 선 + 제목 밑 accent 선(두께로 위계 구분) */
  .section-title--primary,
  .section-title--secondary {
    border-bottom: 1px solid var(--color-border);
  }

  .section-title--primary h2,
  .section-title--secondary h2,
  .section-title--primary a,
  .section-title--secondary a {
    padding-bottom: var(--space-2);
  }

  .section-title--primary h2 {
    margin-bottom: -1px;
    border-bottom: 3px solid var(--color-accent);
    font-size: var(--text-lg);
    font-weight: 800;
  }

  .section-title--primary {
    margin-bottom: var(--space-5);
  }

  .section-title--secondary h2 {
    margin-bottom: -1px;
    border-bottom: 2px solid var(--color-accent);
    font-size: var(--text-md);
  }

  /* utility: 전체 폭 선 없이 짧은 accent 막대 */
  .section-title--utility {
    margin-bottom: var(--space-3);
  }

  .section-title--utility h2 {
    font-size: var(--text-base);
  }

  .section-title--utility h2::before {
    content: '';
    display: block;
    width: 20px;
    height: 3px;
    margin-bottom: var(--space-2);
    background: var(--color-accent);
  }
</style>
