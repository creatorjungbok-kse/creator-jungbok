---
import { statusLabels, type BenefitStatus } from '../lib/benefit-status';

export interface Props {
  href: string;
  title: string;
  category?: string;
  // 지원·혜택 카드의 상태(BenefitCard가 계산해 넘긴다)
  status?: BenefitStatus;
  excerpt?: string;
  meta?: string[];
  // 썸네일은 콘텐츠에 대표 이미지 필드가 생길 때(P8) 추가한다. 지금은 텍스트 카드만 있다.
  large?: boolean;
  // 카드 끝의 이동 안내 문구(홈 '먼저 읽어 볼 가이드'). 카드 전체가 제목 링크라 화면 표시용이다
  cta?: string;
}

const { href, title, category, status, excerpt, meta = [], large = false, cta } = Astro.props;
---

<article class:list={['card', { 'card--large': large }]} data-status={status}>
  <div class="card__body">
    {
      (status || category) && (
        <p class="card__top">
          {status && <span class={`badge badge--${status}`}>{statusLabels[status]}</span>}
          {category && <span>{category}</span>}
        </p>
      )
    }
    <h3 class="card__title"><a href={href}>{title}</a></h3>
    {excerpt && <p class="card__excerpt">{excerpt}</p>}
    {meta.length > 0 && <p class="card__meta">{meta.map((m) => <span>{m}</span>)}</p>}
    {cta && <p class="card__cta" aria-hidden="true">{cta}</p>}
  </div>
</article>

<style>
  .card {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--space-3);
  }

  .card__body {
    display: grid;
    gap: var(--space-2);
  }

  .card__top {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-brand-text);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
  }

  .card__title {
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
    line-height: 1.5;
  }

  .card--large .card__title {
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    line-height: var(--leading-tight);
    letter-spacing: -0.02em;
  }

  /* 카드 전체를 클릭 영역으로 */
  .card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card__excerpt {
    display: -webkit-box;
    overflow: hidden;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .card__meta {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .card__meta span + span::before {
    content: '·';
    margin-inline: var(--space-2);
  }

  .card__cta {
    margin-top: var(--space-1);
    color: var(--color-brand-text);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }
</style>
