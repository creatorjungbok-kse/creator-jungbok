---
export interface Props {
  href: string;
  title: string;
  category?: string;
  status?: 'open' | 'closing';
  excerpt?: string;
  meta?: string[];
  // 썸네일은 대표·최근 콘텐츠에만 쓴다. 없으면 텍스트 카드로 표시된다.
  image?: { src: string; alt: string };
  imagePosition?: 'top' | 'side';
  large?: boolean;
  // 첫 화면의 대표 이미지(LCP 후보)만 true
  priority?: boolean;
}

const {
  href,
  title,
  category,
  status,
  excerpt,
  meta = [],
  image,
  imagePosition = 'top',
  large = false,
  priority = false,
} = Astro.props;
const statusLabel = { open: '신청 중', closing: '마감 임박' } as const;
---

<article class:list={['card', { 'card--side': image && imagePosition === 'side', 'card--large': large }]}>
  {
    image && (
      <img
        class="card__image"
        src={image.src}
        alt={image.alt}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : undefined}
        decoding="async"
      />
    )
  }
  <div class="card__body">
    {
      (status || category) && (
        <p class="card__top">
          {status && <span class={`badge badge--${status}`}>{statusLabel[status]}</span>}
          {category && <span>{category}</span>}
        </p>
      )
    }
    <h3 class="card__title"><a href={href}>{title}</a></h3>
    {excerpt && <p class="card__excerpt">{excerpt}</p>}
    {meta.length > 0 && <p class="card__meta">{meta.map((m) => <span>{m}</span>)}</p>}
  </div>
</article>

<style>
  .card {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--space-3);
  }

  .card--side {
    grid-template-columns: clamp(96px, 30%, 200px) minmax(0, 1fr);
    align-items: start;
    gap: var(--space-4);
  }

  .card__image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .card__body {
    display: grid;
    gap: var(--space-2);
  }

  .card__top {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: 600;
  }

  .badge {
    padding: 0 var(--space-2);
    border-radius: var(--radius-pill);
  }

  .badge--open {
    background: var(--color-status-open-soft);
    color: var(--color-status-open);
  }

  .badge--closing {
    background: var(--color-status-closing-soft);
    color: var(--color-status-closing);
  }

  .card__title {
    font-size: var(--text-md);
    font-weight: 700;
  }

  .card--large .card__title {
    font-size: var(--text-xl);
    letter-spacing: -0.02em;
  }

  /* 카드 전체를 클릭 영역으로 */
  .card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card__excerpt {
    display: -webkit-box;
    overflow: hidden;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .card__meta {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .card__meta span + span::before {
    content: '·';
    margin-inline: var(--space-2);
  }
</style>
