---
// 전기요금 계산기(주택용 저압 일반가구) + 요금표 + 계산 순서. 숫자는 모두 src/tools/electricity-bill/constants.ts에서 온다.
// JavaScript가 없으면 입력칸을 숨기고 예시 결과(그 외 기간 200kWh)와 요금표만 보인다.
import ToolShell from '../ToolShell.astro';
import { electricityBill as c, type Season } from '../../tools/electricity-bill/constants';
import { calcElectricityBill, percent, perKwh, tierLabels, validUntil, won } from '../../tools/electricity-bill/calc';
import { formatDate } from '../../lib/format';

const example = { kWh: 200, season: 'other' as Season };
const r = calcElectricityBill(example.kWh, example.season, c);
const day = (s: string) => formatDate(new Date(s));
const signed = (rate10: number) => `${rate10 >= 0 ? '+' : ''}${perKwh(rate10)}`;
const fuel = c.fuelAdjustment;
const rows: [keyof typeof r, string][] = [
  ['basic', '기본요금'],
  ['energy', '전력량요금'],
  ['climate', `기후환경요금(${perKwh(c.climate.rate10)}/kWh)`],
  ['fuelAdjustment', `연료비조정요금(${signed(fuel.rate10)}/kWh)`],
  ['vat', `부가가치세(${percent(c.vatRate)})`],
  ['fund', `전력산업기반기금(${percent(c.fundRate)})`],
];
const seasonOrder: Season[] = ['other', 'summer'];
const label = (season: Season, kWh: number) => `${c.seasons[season].label} · ${kWh.toLocaleString('ko-KR')}kWh`;
---

<ToolShell id="electricity-bill" title="전기요금 계산기" validUntil={validUntil(c)}>
  <p class="eb-scope">{c.appliesTo} · 월 사용량 {c.minKwh}~{c.maxKwh.toLocaleString('ko-KR')}kWh</p>
  <noscript><p class="eb-noscript">계산기는 JavaScript가 켜져 있어야 동작합니다. 아래 예시 결과와 요금표를 참고하세요.</p></noscript>

  <form class="eb-form" data-eb-form hidden novalidate>
    <fieldset>
      <legend>사용 시기</legend>
      <div class="eb-seasons">
        {
          (['summer', 'other'] as Season[]).map((s) => (
            <label class="eb-season">
              <input type="radio" name="eb-season" value={s} checked={s === 'other'} />
              <span>{c.seasons[s].label}</span>
            </label>
          ))
        }
      </div>
    </fieldset>
    <div class="eb-field">
      <label for="eb-kwh">월 사용량</label>
      <div class="eb-input">
        <input id="eb-kwh" type="text" inputmode="numeric" autocomplete="off" maxlength="6" aria-describedby="eb-kwh-hint eb-kwh-error" />
        <span aria-hidden="true">kWh</span>
      </div>
      <p id="eb-kwh-hint" class="eb-hint">전기요금 청구서나 한전ON의 월 사용량을 정수로 입력하세요.</p>
      <p id="eb-kwh-error" class="eb-error" data-eb-error></p>
    </div>
    <button type="submit">계산하기</button>
  </form>

  <div class="eb-result" data-eb-result>
    <div aria-live="polite" aria-atomic="true">
      <p class="eb-result__label"><span data-eb-kind>예시</span> · <span data-eb-label>{label(example.season, example.kWh)}</span></p>
      <p class="eb-result__total">예상 청구금액 <strong data-eb="total">{won(r.total)}</strong></p>
    </div>
    <dl class="eb-breakdown">
      {
        rows.map(([key, name]) => (
          <div>
            <dt>{name}</dt>
            <dd data-eb={key}>{won(r[key])}</dd>
          </div>
        ))
      }
      <div class="eb-breakdown__total">
        <dt>예상 청구금액</dt>
        <dd data-eb="total">{won(r.total)}</dd>
      </div>
    </dl>
    <p class="eb-notice">{c.appliesTo} 기준의 예상 금액이며 실제 청구액은 계약종별·검침기간·할인 등에 따라 달라질 수 있습니다.</p>
    <p class="eb-basis">
      연료비조정단가 적용 기간 {day(fuel.effectiveFrom)}~{day(fuel.effectiveTo)} · 요금 확인일 {day(c.checkedAt)}
    </p>
  </div>
</ToolShell>

<section class="eb-tariff" aria-labelledby="eb-tariff-title">
  <h2 id="eb-tariff-title">주택용 저압 전기요금표</h2>
  {
    seasonOrder.map((s) => {
      const season = c.seasons[s];
      const names = tierLabels(season.tiers);
      return (
        <div class="table-scroll" tabindex="0" role="region" aria-label={`${season.label} 요금표`}>
          <table>
            <caption>
              {season.label}({season.period})
            </caption>
            <thead>
              <tr>
                <th scope="col">월 사용량</th>
                <th scope="col">기본요금(호당)</th>
                <th scope="col">전력량요금(kWh당)</th>
              </tr>
            </thead>
            <tbody>
              {season.tiers.map((t, i) => (
                <tr>
                  <th scope="row">{names[i]}</th>
                  <td>{won(t.basic)}</td>
                  <td>{perKwh(t.rate10)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      );
    })
  }
  <div class="table-scroll" tabindex="0" role="region" aria-label="함께 붙는 요금">
    <table>
      <caption>함께 붙는 요금</caption>
      <thead>
        <tr>
          <th scope="col">항목</th>
          <th scope="col">계산</th>
        </tr>
      </thead>
      <tbody>
        <tr><th scope="row">기후환경요금</th><td>사용량 × {perKwh(c.climate.rate10)}</td></tr>
        <tr><th scope="row">연료비조정요금</th><td>사용량 × {signed(fuel.rate10)} ({day(fuel.effectiveFrom)}~{day(fuel.effectiveTo)})</td></tr>
        <tr><th scope="row">부가가치세</th><td>전기요금계 × {percent(c.vatRate)}</td></tr>
        <tr><th scope="row">전력산업기반기금</th><td>전기요금계 × {percent(c.fundRate)}</td></tr>
      </tbody>
    </table>
  </div>

  <h3>계산 순서</h3>
  <ol class="eb-steps">
    <li>기본요금: 한 달 사용량이 속한 구간의 기본요금을 한 번 적용합니다.</li>
    <li>전력량요금: 사용량을 구간별로 나눠 구간 단가를 곱해 더합니다(원 미만 버림).</li>
    <li>기후환경요금·연료비조정요금: 사용량에 kWh당 단가를 곱합니다.</li>
    <li>전기요금계: 1~3을 더한 금액입니다.</li>
    <li>부가가치세는 전기요금계의 {percent(c.vatRate)}(원 미만 반올림), 전력산업기반기금은 전기요금계의 {percent(c.fundRate)}(10원 미만 버림)입니다.</li>
    <li>예상 청구금액: 전기요금계 + 부가가치세 + 전력산업기반기금에서 10원 미만을 버립니다.</li>
  </ol>
</section>

<script>
  // 입력값은 이 페이지 안에서만 계산한다(저장·전송·GA 이벤트 없음). form은 제출하지 않는다.
  import { electricityBill as c, type Season } from '../../tools/electricity-bill/constants';
  import { calcElectricityBill, parseKwh, won } from '../../tools/electricity-bill/calc';

  const root = document.querySelector<HTMLElement>('[data-tool="electricity-bill"]');
  const form = root?.querySelector<HTMLFormElement>('[data-eb-form]');
  if (root && form) {
    const input = form.querySelector<HTMLInputElement>('#eb-kwh')!;
    const error = form.querySelector<HTMLElement>('[data-eb-error]')!;
    const radios = [...form.querySelectorAll<HTMLInputElement>('input[name="eb-season"]')];
    const season = () => (radios.find((r) => r.checked)?.value ?? 'other') as Season;
    const result = root.querySelector<HTMLElement>('[data-eb-result]')!;
    // 사용자가 계산한 결과의 사용량(예시 결과일 때는 undefined)
    let shownKwh: number | undefined;

    // 기본 사용 시기: 오늘이 7~8월이면 7~8월
    const month = new Date().getMonth() + 1;
    const initial: Season = month === 7 || month === 8 ? 'summer' : 'other';
    for (const r of radios) r.checked = r.value === initial;

    const show = (kWh: number) => {
      const bill = calcElectricityBill(kWh, season(), c);
      for (const el of root.querySelectorAll<HTMLElement>('[data-eb]')) el.textContent = won(bill[el.dataset.eb as keyof typeof bill]);
      root.querySelector('[data-eb-kind]')!.textContent = '예상 전기요금';
      root.querySelector('[data-eb-label]')!.textContent = `${c.seasons[season()].label} · ${kWh.toLocaleString('ko-KR')}kWh`;
      result.hidden = false;
      shownKwh = kWh;
    };
    // 사용자 계산 뒤 입력이 잘못되거나 바뀌면 이전 결과를 숨긴다(예시 카드로 되돌리지 않는다). 처음의 예시 카드는 그대로 둔다
    const hideStale = () => {
      if (shownKwh !== undefined) result.hidden = true;
    };
    const run = () => {
      const parsed = parseKwh(input.value, c);
      if (!parsed.ok) {
        hideStale();
        error.textContent = parsed.error;
        input.setAttribute('aria-invalid', 'true');
        input.focus();
        return;
      }
      error.textContent = '';
      input.removeAttribute('aria-invalid');
      show(parsed.value);
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      run();
    });
    input.addEventListener('input', () => {
      const parsed = parseKwh(input.value, c);
      if (!parsed.ok || parsed.value !== shownKwh) hideStale();
    });
    // 결과가 보이는 동안 사용 시기를 바꾸면 같은 사용량으로 다시 계산
    for (const r of radios) r.addEventListener('change', () => shownKwh !== undefined && !result.hidden && run());
    form.hidden = false;
  }
</script>

<style>
  .eb-scope,
  .eb-hint,
  .eb-basis {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .eb-noscript {
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    font-size: var(--text-sm);
  }

  .eb-form {
    display: grid;
    gap: var(--space-4);
  }

  fieldset {
    margin: 0;
    padding: 0;
    border: 0;
  }

  legend,
  .eb-field > label {
    margin-bottom: var(--space-2);
    font-weight: var(--weight-semibold);
  }

  .eb-field {
    display: grid;
  }

  .eb-seasons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .eb-season {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--touch);
    padding-inline: var(--space-4);
    border: 1px solid var(--color-outline);
    border-radius: var(--radius-pill);
    cursor: pointer;
  }

  .eb-season:has(input:checked) {
    border-color: var(--color-brand);
    background: var(--color-brand-soft);
    font-weight: var(--weight-semibold);
  }

  .eb-season input {
    accent-color: var(--color-brand-text);
  }

  .eb-input {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    max-width: 16rem;
  }

  .eb-input input {
    flex: 1;
    min-width: 0;
    min-height: 48px;
    padding-inline: var(--space-4);
    border: 1px solid var(--color-outline);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    color: var(--color-text);
    font: inherit;
    font-size: var(--text-md);
    font-variant-numeric: tabular-nums;
  }

  .eb-input input[aria-invalid='true'] {
    border-color: var(--color-status-closing);
  }

  .eb-hint {
    margin-top: var(--space-1);
  }

  .eb-error {
    color: var(--color-status-closing);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  .eb-error:empty {
    display: none;
  }

  .eb-form button {
    justify-self: start;
    min-height: 48px;
    padding-inline: var(--space-6);
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--color-brand);
    color: var(--color-text);
    font: inherit;
    font-weight: var(--weight-bold);
    cursor: pointer;
  }

  .eb-result {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-4);
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .eb-result__label {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  .eb-result__total {
    font-size: var(--text-sm);
  }

  .eb-result__total strong {
    display: block;
    font-size: var(--text-2xl);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
  }

  .eb-breakdown {
    display: grid;
    font-size: var(--text-sm);
  }

  .eb-breakdown div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: var(--space-2);
    border-top: 1px solid var(--color-border);
  }

  .eb-breakdown dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .eb-breakdown__total {
    font-weight: var(--weight-bold);
  }

  .eb-notice {
    font-size: var(--text-sm);
  }

  .eb-tariff {
    display: grid;
    gap: var(--space-4);
  }

  .eb-tariff h2 {
    font-size: var(--text-lg);
    letter-spacing: -0.01em;
  }

  .eb-tariff h3 {
    font-size: var(--text-md);
  }

  .eb-tariff td {
    font-variant-numeric: tabular-nums;
  }

  /* 좁은 화면에서도 가로 스크롤 없이 보이도록 줄바꿈 허용 */
  .eb-tariff th,
  .eb-tariff td {
    padding-inline: var(--space-3);
    white-space: normal;
  }

  /* 구간 이름(201~400kWh)은 중간에서 끊지 않는다 */
  .eb-tariff tbody th {
    white-space: nowrap;
  }

  .eb-steps {
    display: grid;
    gap: var(--space-2);
    padding-left: 1.25em;
    font-size: var(--text-sm);
    list-style: decimal;
  }
</style>
