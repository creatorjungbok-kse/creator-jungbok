---
// 사이트 도구(계산기 등) 공통 틀. 틀 전체가 광고 금지 영역(data-ad-protected="tool")이다.
// 입력값은 저장·전송하지 않는다: form을 제출하지 않고(입력칸에 name 없음), GA 이벤트도 보내지 않는다.
// data-valid-until: 도구 상수의 유효 기한. production check-build가 기한 14일 전부터 Warning, 지나면 Fail로 막는다.
export interface Props {
  id: string;
  title: string;
  validUntil?: string;
}

const { id, title, validUntil } = Astro.props;
---

<section class="tool-shell" data-ad-protected="tool" data-tool={id} data-valid-until={validUntil} aria-labelledby={`${id}-title`}>
  <h2 id={`${id}-title`}>{title}</h2>
  <slot />
</section>

<style>
  .tool-shell {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg);
  }

  h2 {
    font-size: var(--text-lg);
    letter-spacing: -0.01em;
  }
</style>
