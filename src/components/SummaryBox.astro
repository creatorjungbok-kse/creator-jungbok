---
// 글 상단 '핵심 요약'. 요약 문장을 한 줄씩 나눠 목록으로 보여 준다. 광고 금지 영역(data-ad-protected).
import { splitSummary } from '../lib/summary';

export interface Props {
  summary: string;
  title?: string;
}

const { summary, title = '핵심 요약' } = Astro.props;
const items = splitSummary(summary);
---

<section class="summary-box" data-ad-protected="summary">
  <h2>{title}</h2>
  <ul>
    {items.map((s) => <li>{s}</li>)}
  </ul>
</section>

<style>
  .summary-box {
    display: grid;
    gap: var(--space-2);
    justify-items: start;
    padding: var(--space-4) var(--space-5);
    border-left: 4px solid var(--color-link);
    border-radius: 0 var(--radius) var(--radius) 0;
    background: var(--color-link-soft);
  }

  /* 파란 강조 라벨(글자만) */
  h2 {
    color: var(--color-link-strong);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
  }

  ul {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding-left: 1.2em;
    list-style: disc;
  }
</style>
