---
// 글 상단 요약(cost 등: 결론부터 / benefit: 핵심 요약). 광고 금지 영역(data-ad-protected).
export interface Props {
  summary: string;
  title?: string;
}

const { summary, title = '결론부터' } = Astro.props;
---

<section class="summary-box" data-ad-protected="summary">
  <h2>{title}</h2>
  <p>{summary}</p>
</section>

<style>
  .summary-box {
    display: grid;
    gap: var(--space-2);
    justify-items: start;
    padding: var(--space-5);
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  /* 꿀색 강조 라벨 */
  h2 {
    padding: 2px var(--space-2);
    border-radius: var(--radius-sm);
    background: var(--color-brand-soft);
    font-size: var(--text-sm);
  }
</style>
