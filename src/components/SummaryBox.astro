---
// 글 상단 요약(cost 등: 결론부터 / benefit: 핵심 요약). 광고 금지 영역(data-ad-protected).
export interface Props {
  summary: string;
  title?: string;
}

const { summary, title = '결론부터' } = Astro.props;
---

<section class="summary-box" data-ad-protected="summary">
  <h2>{title}</h2>
  <p>{summary}</p>
</section>

<style>
  .summary-box {
    display: grid;
    gap: var(--space-2);
    justify-items: start;
    padding: var(--space-4) var(--space-5);
    border-left: 4px solid var(--color-link);
    border-radius: 0 var(--radius) var(--radius) 0;
    background: var(--color-link-soft);
  }

  /* 파란 강조 라벨(글자만) */
  h2 {
    color: var(--color-link-strong);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
  }
</style>
