---
// dev 전용 셸 미리보기. env.ts의 isShellPreview가 켜진 경우에만 페이지가 생성된다.
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import HomeView from '../../components/HomeView.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import { isShellPreview } from '../../config/env';
import { categories } from '../../data/categories';
import { articleFixture as a, homeFixture } from '../../dev/fixtures';

export function getStaticPaths() {
  return isShellPreview ? [{ params: { view: 'home' } }, { params: { view: 'article' } }] : [];
}

const { view } = Astro.params;
const business = categories.find((c) => c.slug === 'business')!;
const para =
  '예시 문단입니다. 실제 글에서는 조사 기준일과 출처를 밝힌 가격 범위, 조건별 차이, 확인 방법을 이 자리에 씁니다. 문장 길이와 줄 간격, 한글 줄바꿈을 확인하기 위한 텍스트입니다.';
---

{
  view === 'home' ? (
    <BaseLayout title="홈 셸 미리보기" noindex canonical={false}>
      <HomeView {...homeFixture} />
    </BaseLayout>
  ) : (
    <ArticleLayout {...a} category={business} noindex canonical={false}>
      <h2 id="summary">결론부터</h2>
      <p>{para}</p>
      <div class="table-scroll">
        <table>
          <caption>예시 · 조건별 가격 범위 (VAT 별도)</caption>
          <thead>
            <tr><th scope="col">조건</th><th scope="col">가격 범위</th><th scope="col">기준</th><th scope="col">비고</th><th scope="col">업데이트</th></tr>
          </thead>
          <tbody>
            <tr><td>유선 단말기 구매</td><td>예시 10~20만 원</td><td>본체만</td><td>설치비 별도인 경우가 많음</td><td>2026.09</td></tr>
            <tr><td>무선 단말기 구매</td><td>예시 15~30만 원</td><td>본체만</td><td>배터리·충전기 포함 여부 확인</td><td>2026.09</td></tr>
            <tr><td>단말기 임대</td><td>예시 월 1~2만 원</td><td>약정 기준</td><td>위약금 조건 확인</td><td>2026.09</td></tr>
          </tbody>
        </table>
      </div>
      <AdSlot id="article-top" />
      <h2 id="range">가격 범위</h2>
      <p>{para}</p>
      <p>{para}</p>
      <h2 id="why">가격이 달라지는 이유</h2>
      <p>{para}</p>
      <ul>
        <li>예시 · 유선·무선 여부</li>
        <li>예시 · 구매·임대 방식</li>
        <li>예시 · 약정 기간</li>
      </ul>
      <h2 id="extra">추가 비용</h2>
      <p>{para}</p>
      <p>{para}</p>
      <h2 id="checklist">선택 체크리스트</h2>
      <p>{para}</p>
      <AdSlot id="article-lower" />
      <h2 id="faq">자주 묻는 질문</h2>
      <p>{para}</p>
      <section slot="after">
        <SectionTitle title="관련 비용 정보" />
        <div class="card-grid card-grid--3">
          {a.related.map((c) => (
            <ArticleCard {...c} />
          ))}
        </div>
      </section>
    </ArticleLayout>
  )
}
