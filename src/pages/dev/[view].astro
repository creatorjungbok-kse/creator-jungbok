---
// dev 전용 홈 셸 미리보기. env.ts의 isShellPreview가 켜진 경우에만 페이지가 생성된다.
// 글 화면은 fixture 콘텐츠로 실제 route(/{category}/fixture-*/)에서 확인한다. P6에서 홈이 실제 데이터로 바뀌면 삭제한다.
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeView from '../../components/HomeView.astro';
import { isShellPreview } from '../../config/env';
import { homeFixture } from '../../dev/fixtures';

export function getStaticPaths() {
  return isShellPreview ? [{ params: { view: 'home' } }] : [];
}
---

<BaseLayout title="홈 셸 미리보기" noindex canonical={false}>
  <HomeView {...homeFixture} />
</BaseLayout>
