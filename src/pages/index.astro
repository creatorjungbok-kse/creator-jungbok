---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeView from '../components/HomeView.astro';
import { categoryHref } from '../data/categories';
import { getAllContent, primaryNavCategories, type ContentItem } from '../lib/content';
import { homeJsonLd } from '../lib/seo';
import { latestPublished, statusOf, urgentBenefits } from '../lib/select';
import { toolIds, toolNames } from '../tools/registry';
import { popularUrls } from '../config/home';

// 홈 섹션 구성(01 D). 선택 규칙은 lib/select.ts.
// 한 글은 홈에서 한 번만 보인다: 위 섹션에 나온 글은 아래 섹션에서 뺀다(shown).
// 홈에는 신청 종료된 지원을 올리지 않는다(종료 지원은 /benefits/의 종료 목록에서 찾는다).
const all = await getAllContent();
const listed = all.filter((i) => statusOf(i) !== 'closed');
const shown = new Set<ContentItem>();
const take = (items: ContentItem[], n: number) => {
  const out = items.filter((i) => !shown.has(i)).slice(0, n);
  out.forEach((i) => shown.add(i));
  return out;
};

// 0. 대표 글: 가장 최근에 올린 글(지원사업 제외, 이미지 카드로 보이는 일반 글)
const lead = take(latestPublished(listed.filter((i) => i.kind === 'article')), 1)[0];

// 1. 요즘 많이 찾는 글(4개)·사이드바 인기 글(나머지 최대 5개): config/home.ts에서 직접 고른 목록
const popularAll = popularUrls.flatMap((u) => listed.filter((i) => i.url === u));
const trending = take(popularAll, 4);
const popular = take(popularAll, 5);

// 2. 최신 글: 최근 게시 순, 위에 나온 글 제외 6개(일반 글만, 이미지 카드)
const latest = take(latestPublished(listed.filter((i) => i.kind === 'article')), 6);

// 3. 지금 확인할 혜택: 마감 임박 → 7일 안에 시작 → 신청 가능 순, 최대 4개
const urgentAll = urgentBenefits(listed);
const urgent = take(urgentAll, 4);

// 4. 계산기: 도구가 들어 있는 글 앞 6개(도구 바로가기 목록이라 위 카드와 겹쳐도 보인다)
const tools = toolIds.flatMap((id) => {
  const item = listed.find((i) => i.kind === 'article' && i.entry.data.tool === id);
  return item ? [{ item, name: toolNames[id] }] : [];
}).slice(0, 6); // 전체 목록은 사이드바 '계산기·도구'

// 5. 분야별: 분야 이름·전체 글 수는 그대로, 목록은 위에 안 나온 글만(최대 3개)
const sections = (await primaryNavCategories()).map((c) => {
  const items = latestPublished(listed.filter((i) => i.category === c.slug));
  return { category: c, href: categoryHref(c), count: items.length, items: take(items, 3) };
});
---

<BaseLayout jsonLd={homeJsonLd()}>
  <HomeView
    lead={lead}
    trending={trending}
    popular={popular}
    latest={latest}
    urgent={urgent}
    moreUrgent={urgentAll.length > urgent.length}
    tools={tools.map((t) => ({ href: t.item.url, name: t.name, summary: t.item.entry.data.description ?? t.item.entry.data.summary }))}
    sections={sections}
    isEmpty={all.length === 0}
  />
</BaseLayout>
