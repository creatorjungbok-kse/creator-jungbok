---
// 일반 대분류(business·living·digital). /benefits/는 src/pages/benefits/index.astro(허브)가 맡는다.
// 블로그 카테고리 화면: 짧은 머리말 + 세부 분류 칩(글이 있는 것만) → 세부 분류별 글 목록(이미지 + 제목 + 요약 + 날짜).
// 인기 데이터가 필요한 "많이 찾는 비용"은 두지 않는다. 세부 분류는 첫 글이 생기면 코드 수정 없이 나타난다.
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogSidebar from '../../components/BlogSidebar.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ContentCard from '../../components/ContentCard.astro';
import MiniList from '../../components/MiniList.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import { categories, categoryHref, type Category } from '../../data/categories';
import { getAllContent } from '../../lib/content';
import { collectionJsonLd } from '../../lib/seo';
import { latestPublished, openBenefits } from '../../lib/select';

export function getStaticPaths() {
  return categories.filter((c) => c.slug !== 'benefits').map((category) => ({ params: { category: category.slug }, props: { category } }));
}

interface Props {
  category: Category;
}

const { category } = Astro.props;
const all = await getAllContent();
const items = all.filter((i) => i.category === category.slug);
// registry 순서대로, 글이 있는 세부 분류만. 안에서는 최근 게시 순
const bySub = category.subcategories
  .map((sub) => ({ sub, items: latestPublished(items.filter((i) => i.entry.data.subcategory === sub.slug)) }))
  .filter((s) => s.items.length > 0);
// 이 대분류 글과 주제가 겹치는 신청 가능 지원(01 E "관련 지원·혜택 — 신청 가능 상태만")
const topics = new Set(items.flatMap((i) => i.entry.data.topics));
const relatedBenefits = openBenefits(all.filter((i) => i.entry.data.topics.some((t) => topics.has(t)))).slice(0, 5);
const links = (list: typeof items) => list.map((i) => ({ href: i.url, title: i.entry.data.title }));
---

<BaseLayout title={category.seoTitle} description={category.description} noindex={items.length === 0} jsonLd={[collectionJsonLd(category.title, category.description, categoryHref(category))]}>
  <div class="container page-grid">
    <div class="page-main">
      <header class="page-head category-head">
        <Breadcrumb items={[{ label: category.name }]} />
        <h1>{category.title}</h1>
        <p>{category.description}</p>
        {
          // 세부 분류가 2개 이상일 때만 이동 칩을 둔다(1개면 아래 묶음 제목과 겹친다)
          bySub.length >= 2 && (
            <nav class="chips" aria-label="세부 분류">
              {bySub.map(({ sub, items }) => (
                <a class="chip" href={`#sub-${sub.slug}`}>
                  {sub.name}
                  <span class="chip__count">{items.length}<span class="visually-hidden">개</span></span>
                </a>
              ))}
            </nav>
          )
        }
      </header>

      {
        items.length === 0 && (
          <div class="empty">
            <p>이 카테고리의 첫 정보를 준비하고 있습니다.</p>
            <p>다룰 주제: {category.subcategories.map((s) => s.name).join(' · ')}</p>
          </div>
        )
      }

      {
        bySub.map(({ sub, items }) => (
          <section id={`sub-${sub.slug}`} class="sub-section">
            <SectionTitle title={sub.name} tier="primary" />
            <div class="card-list">
              {items.map((item) => (
                <ContentCard item={item} variant="row" label="none" />
              ))}
            </div>
          </section>
        ))
      }
    </div>

    <aside class="page-aside" aria-label="카테고리와 도구">
      {
        relatedBenefits.length > 0 && (
          <div data-open-list>
            <MiniList title="신청 가능한 관련 지원" items={links(relatedBenefits)} />
          </div>
        )
      }
      <BlogSidebar current={category.slug} />
    </aside>
  </div>
</BaseLayout>

<style>
  /* 머리말은 짧게: 글 목록이 주인공 */
  .category-head {
    gap: var(--space-2);
  }

  .category-head p {
    font-size: var(--text-sm);
  }

  .category-head .chips {
    margin-top: var(--space-2);
  }

  .chip__count {
    margin-left: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
  }

  /* 칩으로 이동했을 때 고정 헤더에 제목이 가리지 않게 */
  .sub-section {
    scroll-margin-top: calc(var(--header-h) + var(--space-4));
  }
</style>
